---
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import { DEFAULT_LOCALE, locales, localeCodes } from '../i18n/locales';
// Self-hosted Inter. Google's font CDN is a live GDPR exposure for an Austrian
// operator (German/Austrian rulings treat the IP transfer as a violation), and
// it also cost a render-blocking round trip to a third-party origin.
import '@fontsource-variable/inter';
import 'swiper/css';
import '../styles/style.css';
import '../styles/animate.css';

type Props = SeoProps & { bodyClass?: string };
const { bodyClass = 'bg-white dark:bg-black', ...seo } = Astro.props;
const lang = locales[seo.lang].htmlLang;

/**
 * Sends a visitor whose browser prefers another language to that language's
 * counterpart of the page they asked for, once, before anything paints.
 *
 * Deliberately one-way: it only ever moves someone *off* the default locale.
 * Googlebot crawls with an English Accept-Language, so a two-way rule would
 * bounce it off every localised URL and out of the index. The targets come
 * from the hreflang alternates already in the head, so this works on any page
 * that has counterparts and needs no second map to maintain. An explicit click
 * on the language switcher writes `breezer_lang`, and that always wins.
 *
 * The locale list is interpolated from the registry rather than hard-coded, so
 * adding a language does not mean remembering to edit a string of inline JS.
 *
 * Injected via set:html because Astro treats the body of a <script> as raw
 * text: an expression written inline ships as literal source and does nothing.
 */
const redirectLocales = localeCodes.filter((code) => code !== DEFAULT_LOCALE);
const langInit = `(function () {
  try {
    if (${JSON.stringify(seo.lang !== DEFAULT_LOCALE)}) return;
    if (localStorage.getItem('breezer_lang')) return;

    var targets = ${JSON.stringify(redirectLocales)};
    var prefs = navigator.languages && navigator.languages.length
      ? navigator.languages
      : [navigator.language || ''];

    var want = null;
    for (var i = 0; i < prefs.length && !want; i++) {
      var tag = (prefs[i] || '').toLowerCase();
      // The default locale ranking first means stay put; anything unknown is
      // skipped so a third preference can still decide.
      if (tag.indexOf(${JSON.stringify(DEFAULT_LOCALE)}) === 0) return;
      for (var j = 0; j < targets.length; j++) {
        if (tag.indexOf(targets[j]) === 0) { want = targets[j]; break; }
      }
    }
    if (!want) return;

    var alt = document.querySelector('link[rel="alternate"][hreflang^="' + want + '"]');
    if (!alt) return;
    // Only the path is taken from the alternate. Those hrefs are absolute
    // production URLs, so following one wholesale would throw a visitor on a
    // preview deployment (or a dev server) over to the live site.
    var path = new URL(alt.getAttribute('href'), location.href).pathname;
    if (path === location.pathname) return;
    location.replace(path + location.search + location.hash);
  } catch (e) {}
})();`;

/**
 * Runs before first paint so the saved/system theme doesn't flash the wrong way
 * for a frame while the deferred bundle loads.
 *
 * A stored value that already matches the browser is deleted rather than
 * honoured. With only two states, storing "light" while the browser is light
 * pins the site to light forever, and a visitor who once tapped the toggle can
 * never get back to following their browser. Keeping the key only while it
 * diverges makes "follow the browser" the state you return to.
 */
const themeInit = `(function () {
  try {
    var systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
    var stored = localStorage.getItem('theme');
    if (stored === (systemDark ? 'dark' : 'light')) {
      localStorage.removeItem('theme');
      stored = null;
    }
    if (stored === 'dark' || (stored !== 'light' && systemDark)) {
      document.documentElement.classList.add('dark');
    }
  } catch (e) {}
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo {...seo} />
    {/* Language first: if it redirects, the theme work belongs to the new page. */}
    <script is:inline set:html={langInit} />
    <script is:inline set:html={themeInit} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
