---
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
// Self-hosted Inter. Google's font CDN is a live GDPR exposure for an Austrian
// operator (German/Austrian rulings treat the IP transfer as a violation), and
// it also cost a render-blocking round trip to a third-party origin.
import '@fontsource-variable/inter';
import 'swiper/css';
import '../styles/style.css';
import '../styles/animate.css';

type Props = SeoProps & { bodyClass?: string };
const { bodyClass = 'bg-white dark:bg-black', ...seo } = Astro.props;
const lang = seo.lang === 'de' ? 'de-AT' : 'en';

// Runs before first paint so the saved/system theme doesn't flash the wrong way
// for a frame while the deferred bundle loads. Injected via set:html because
// Astro treats the body of a <script> as raw text: an expression written inline
// ships as literal source and silently does nothing.
const themeInit = `(function () {
  try {
    var t = localStorage.getItem('theme');
    if (t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  } catch (e) {}
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo {...seo} />
    <script is:inline set:html={themeInit} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
