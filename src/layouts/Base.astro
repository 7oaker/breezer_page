---
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
// Self-hosted Inter. Google's font CDN is a live GDPR exposure for an Austrian
// operator (German/Austrian rulings treat the IP transfer as a violation), and
// it also cost a render-blocking round trip to a third-party origin.
import '@fontsource-variable/inter';
import 'swiper/css';
import '../styles/style.css';
import '../styles/animate.css';

type Props = SeoProps & { bodyClass?: string; forceDark?: boolean };
const { bodyClass = 'bg-white dark:bg-black', forceDark = false, ...seo } = Astro.props;
const lang = seo.lang === 'de' ? 'de-AT' : 'en';
---

<!doctype html>
<html lang={lang} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo {...seo} />
    {
      forceDark ? (
        <script is:inline>
          {`// Content pages render dark. Deliberately does NOT write localStorage:
          // the old build did, so opening any subpage silently flipped the
          // visitor's homepage to dark for good.
          document.documentElement.classList.add('dark');`}
        </script>
      ) : (
        // Runs before first paint so the saved/system theme doesn't flash light
        // for a frame while the deferred bundle loads.
        <script is:inline>
          {`(function () {
            try {
              var t = localStorage.getItem('theme');
              if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
              }
            } catch (e) {}
          })();`}
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
