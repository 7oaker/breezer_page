---
/**
 * Shared shell for guides and blog posts: breadcrumb, H1, prose body, a visible
 * FAQ rendered from the same array that feeds FAQPage schema, and a store CTA.
 */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreButtons from '../components/StoreButtons.astro';
import PhoneShot from '../components/PhoneShot.astro';
import type { ImageMetadata } from 'astro';
import { route, type Lang } from '../i18n/routes';
import { organization, breadcrumbs, faqPage } from '../i18n/schema';
import { getAuthor } from '../data/authors';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  lang: Lang;
  title: string;
  heading: string;
  description: string;
  summary: string;
  path: string;
  altPath?: string;
  crumbs: Crumb[];
  publishDate: Date;
  updatedDate?: Date;
  faq?: { q: string; a: string }[];
  /** 'BlogPosting' for posts, 'Article' for evergreen guides. */
  schemaType?: 'Article' | 'BlogPosting';
  author?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  gallery?: { image: ImageMetadata; alt: string; caption?: string }[];
}

const {
  lang,
  title,
  heading,
  description,
  summary,
  path,
  altPath,
  crumbs,
  publishDate,
  updatedDate,
  faq = [],
  schemaType = 'Article',
  author = 'Breezer Team',
  heroImage,
  heroImageAlt,
  gallery = [],
} = Astro.props;

const site = 'https://breezer.now';
const iso = (d: Date) => d.toISOString().slice(0, 10);
const de = lang === 'de';

const copy = {
  en: { faqHeading: 'Frequently asked questions', ctaHeading: 'Try Breezer for free', ctaBody: 'Download Breezer and start tracking in under a minute.', updated: 'Updated', published: 'Published', writtenBy: 'Written by' },
  de: { faqHeading: 'Häufige Fragen', ctaHeading: 'Breezer kostenlos testen', ctaBody: 'Lade Breezer und starte in unter einer Minute.', updated: 'Aktualisiert', published: 'Veröffentlicht', writtenBy: 'Geschrieben von' },
}[lang];

// A named person in the registry gets a full Person node and a visible box; an
// unlisted name falls back to the organisation. See src/data/authors.ts for why.
const profile = getAuthor(author);

const article = {
  '@type': schemaType,
  headline: title,
  description: summary,
  inLanguage: de ? 'de-AT' : 'en',
  mainEntityOfPage: `${site}${path}`,
  datePublished: iso(publishDate),
  dateModified: iso(updatedDate ?? publishDate),
  // Deliberately the 1200x630 OG image, not the hero: Article rich results want
  // a landscape image, and referencing heroImage.src would make Astro emit the
  // untouched multi-MB original alongside the optimised variants.
  image: `${site}/images/og-image.png`,
  // Only a real person gets a Person node. An editorial byline points at the
  // organisation, because claiming a human author that does not exist is the
  // same false signal as a stock headshot, just machine-readable.
  author:
    profile && profile.isPerson
      ? {
          '@type': 'Person',
          name: profile.displayName[lang],
          url: profile.url,
          jobTitle: profile.role[lang],
          description: profile.bio[lang],
          ...(profile.image ? { image: `${site}${profile.image}` } : {}),
          ...(profile.sameAs?.length ? { sameAs: profile.sameAs } : {}),
        }
      : { '@id': `${site}/#organization` },
  publisher: { '@id': `${site}/#organization` },
};

const schema: Record<string, unknown>[] = [
  organization,
  article,
  breadcrumbs(crumbs),
  ...(faq.length ? [faqPage(faq)] : []),
];

const fmt = (d: Date) =>
  d.toLocaleDateString(de ? 'de-AT' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base
  lang={lang}
  title={title}
  description={description}
  path={path}
  altPath={altPath}
  ogType="article"
  imageAlt={heading}
  publishedTime={iso(publishDate)}
  modifiedTime={iso(updatedDate ?? publishDate)}
  schema={schema}
>
  <Header lang={lang} />
  <main class="pt-[120px] pb-16">
    <article class="container max-w-[820px]">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-body">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i < crumbs.length - 1 ? <a href={c.path} class="hover:text-primary">{c.name}</a> : <span>{c.name}</span>}
          </>
        ))}
      </nav>

      <h1 class="mb-4 text-3xl font-bold text-black dark:text-white sm:text-[44px]">{heading}</h1>

      {/*
        Both dates are shown, not just the newer one: a visible publication date
        alongside the update date is what separates a genuinely maintained page
        from one that only had its timestamp bumped.
      */}
      <p class="mb-8 text-sm text-body">
        <time datetime={iso(publishDate)}>{copy.published} {fmt(publishDate)}</time>
        {updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
          <>
            <span aria-hidden="true"> · </span>
            <time datetime={iso(updatedDate)}>{copy.updated} {fmt(updatedDate)}</time>
          </>
        )}
        <span aria-hidden="true"> · </span>{profile ? <a href={profile.url} class="hover:text-primary">{profile.displayName[lang]}</a> : author}
      </p>

      {
        heroImage ? (
          <div class="mb-10 flex flex-col gap-10 sm:flex-row sm:items-start sm:gap-12">
            <div class="prose-breezer min-w-0 flex-1 text-base leading-relaxed text-body">
              <slot />
            </div>
            <PhoneShot
              src={heroImage}
              alt={heroImageAlt ?? heading}
              eager
              class="order-first shrink-0 sm:order-last sm:mx-0 sm:w-[240px] lg:w-[280px]"
            />
          </div>
        ) : (
          <div class="prose-breezer text-base leading-relaxed text-body">
            <slot />
          </div>
        )
      }

      {gallery.length > 0 && (
        <section class="mt-14">
          <ul class="flex flex-wrap justify-center gap-8 sm:justify-start">
            {gallery.map((g) => (
              <li class="w-[200px] sm:w-[220px]">
                <PhoneShot src={g.image} alt={g.alt} />
                {g.caption && <p class="mt-4 text-center text-sm text-body">{g.caption}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {faq.length > 0 && (
        <section class="mt-12 space-y-6 text-base leading-relaxed text-body">
          <h2 class="text-2xl font-bold text-black dark:text-white">{copy.faqHeading}</h2>
          {faq.map((item) => (
            <div>
              <h3 class="mb-2 text-lg font-semibold text-black dark:text-white">{item.q}</h3>
              <p>{item.a}</p>
            </div>
          ))}
        </section>
      )}

      {profile && (
        <aside class="mt-12 rounded-lg border border-stroke p-6 dark:border-stroke-dark">
          <p class="mb-1 text-xs uppercase tracking-wide text-body">{copy.writtenBy}</p>
          <div class="flex items-start gap-4">
            {profile.image && (
              <img
                src={profile.image}
                alt={profile.displayName[lang]}
                width="64"
                height="64"
                loading="lazy"
                class="h-16 w-16 shrink-0 rounded-full object-cover"
              />
            )}
            <div class="min-w-0">
              <p class="text-base font-semibold text-black dark:text-white">
                <a href={profile.url} class="hover:text-primary">{profile.displayName[lang]}</a>
              </p>
              <p class="mb-2 text-sm text-body">{profile.role[lang]}</p>
              <p class="text-sm leading-relaxed text-body">{profile.bio[lang]}</p>
            </div>
          </div>
        </aside>
      )}

      <div class="mt-12 rounded-lg bg-[#F8FAFB] p-8 dark:bg-[#15182B]">
        <h2 class="mb-4 text-2xl font-bold text-black dark:text-white">{copy.ctaHeading}</h2>
        <p class="mb-6 text-base text-body">{copy.ctaBody}</p>
        <StoreButtons lang={lang} />
      </div>

      <p class="mt-10 text-sm text-body">
        <a href={route('blog', lang)} class="text-primary hover:underline">
          {de ? '← Alle Artikel' : '← All articles'}
        </a>
      </p>
    </article>
  </main>
  <Footer lang={lang} />
</Base>
