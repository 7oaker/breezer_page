interface Props {
  name: keyof typeof PATHS | string;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;
const body = PATHS[name];
if (!body) throw new Error(`Icon "${name}" is not inlined in src/components/Icon.astro`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={body}
/>
