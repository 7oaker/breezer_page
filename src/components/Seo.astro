---
/**
 * Every <head> tag that matters for search and AI crawlers, in one place.
 * Anything that needs to be in the first HTTP response lives here — AI crawlers
 * (GPTBot, ClaudeBot, PerplexityBot, …) do not execute JavaScript, so nothing
 * SEO-relevant may be added client-side.
 */
import { hreflangLinks, locales, localeCodes, type Locale, type LocalePaths } from '../i18n/locales';

export interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** This page's own path, without origin, e.g. "/snus-tracker". */
  path: string;
  /**
   * Where this same page lives in the other languages, keyed by locale. The
   * current locale is filled in from `path`, so callers only pass the others.
   * A locale left out is a locale this page does not exist in, and nothing is
   * claimed for it. Google throws away the whole cluster when one alternate
   * does not point back, so absence has to be honest.
   */
  alternates?: LocalePaths;
  /** @deprecated single-counterpart shorthand; use `alternates`. */
  altPath?: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra JSON-LD nodes to merge into the page graph. */
  schema?: Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  path,
  alternates,
  altPath,
  ogType = 'website',
  image = '/images/og-image.png',
  imageAlt,
  noindex = false,
  publishedTime,
  modifiedTime,
  schema = [],
} = Astro.props as Props;

const site = Astro.site?.origin ?? 'https://breezer.now';
const abs = (p: string) => new URL(p, site).href;

const canonical = abs(path);

// The page's own locale is never passed in, it is what `path` already is.
// Deriving it here means a caller cannot accidentally omit itself from its own
// alternate set, which is the single most common way hreflang gets broken.
const others: LocalePaths = { ...alternates };
if (altPath) {
  const other = (Object.keys(locales) as Locale[]).find((code) => code !== lang);
  if (other && !others[other]) others[other] = altPath;
}
const localePaths: LocalePaths = { ...others, [lang]: path };
const links = hreflangLinks(localePaths).map((l) => ({ ...l, href: abs(l.path) }));
const otherOgLocales = (Object.keys(locales) as Locale[])
  .filter((code) => code !== lang && localePaths[code])
  .map((code) => locales[code].ogLocale);
---

<title>{title}</title>
<meta name="description" content={description} />
{/*
  max-image-preview:large is the precondition for the large Google Discover card
  and for image-led result formats; without it Google caps previews at a thumbnail.
  max-snippet:-1 and max-video-preview:-1 lift the text and video preview caps,
  which matters because AI Overviews and passage ranking extract from the snippet.
*/}
<meta
  name="robots"
  content={noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<link rel="canonical" href={canonical} />

{links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Breezer" />
<meta property="og:image" content={abs(image)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />
<meta property="og:locale" content={locales[lang].ogLocale} />
{otherOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={abs(image)} />
<meta name="twitter:site" content="@breezerapp" />

{/*
  Feed discovery. A reader or an agent looks for this in the head, not in
  robots.txt. The current language's feed comes first so a client that takes
  only the first one takes the right one.
*/}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`Breezer Blog (${locales[lang].label})`}
  href={abs(`${locales[lang].prefix}/feed.xml`)}
/>
{
  localeCodes
    .filter((code) => code !== lang)
    .map((code) => (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`Breezer Blog (${locales[code].label})`}
        href={abs(`${locales[code].prefix}/feed.xml`)}
        hreflang={locales[code].hreflang[0]}
      />
    ))
}

<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0D6BCD" />
<meta name="google-site-verification" content="bwKXk7Y2z1UH9uVey_xx8RvpBl3cFq4OClKifDmF0ms" />

{
  schema.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })}
    />
  )
}
