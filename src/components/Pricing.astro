---
/**
 * The Pro page.
 *
 * A product page, not an article: somebody arrives here to decide, so the page
 * is built to be read in the order a decision gets made — what it costs, what
 * each side gives you, where the free version stops, how to get Pro without
 * paying, and only then the reasoning behind the price, in the founder's own
 * voice.
 *
 * The one loud element is the price expressed in cans. Breezer's reader already
 * buys something weekly, and a can is the unit they judge every other cost
 * against, so "less than half a can a month" lands where "€2.99" only informs.
 * Everything around it stays quiet: the plan pair is the site's own card
 * language, and the comparison rows are the same tinted-chip list the homepage
 * uses, so the page reads as part of the product rather than as a price sheet
 * bought from a template.
 *
 * The comparison is one table per mode with a Free and a Pro column, because
 * the app itself splits tracking from quitting and a visitor only cares about
 * their half. Free rows come first inside each: the argument of this page is
 * that the free half is complete, and an argument is made by what is listed
 * first.
 *
 * All copy and every number live in `src/i18n/pricing.ts`, including the prices,
 * which are hardcoded and have no build-time source — see the warning there.
 */
import StoreButtons from './StoreButtons.astro';
import Icon from './Icon.astro';
import FounderPortrait from './FounderPortrait.astro';
import type { Lang } from '../i18n/routes';
import { pricing } from '../i18n/pricing';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pricing[lang];

/**
 * Split per mode rather than labelled per row: a tier word under all nineteen
 * rows is nineteen repetitions of something two subheads say once.
 */
const modes = [
  {
    label: t.tracking,
    icon: 'analytics',
    free: t.rows.track.filter((r) => r.free),
    pro: t.rows.track.filter((r) => !r.free),
  },
  {
    label: t.quitting,
    icon: 'monitor-heart',
    free: t.rows.quit.filter((r) => r.free),
    pro: t.rows.quit.filter((r) => !r.free),
  },
];
---

<main class="pb-24 pt-[130px]">
  <div class="container max-w-[1000px]">
    <header class="max-w-[640px]">
      <h1 class="text-4xl font-bold leading-tight text-black dark:text-white sm:text-[52px] sm:leading-[1.05]">
        {t.heading}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-body">{t.intro}</p>
    </header>

    {/* The two plans, side by side, Free first. */}
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <section class="rounded-3xl border border-stroke bg-white p-7 dark:border-stroke-dark dark:bg-dark sm:p-9">
        <h2 class="text-lg font-semibold text-black dark:text-white">{t.plans.free.name}</h2>
        <p class="mt-6 text-5xl font-bold tabular-nums leading-none text-black dark:text-white">
          {t.plans.free.price}
        </p>
        <p class="mt-3 text-sm text-body">{t.plans.free.period}</p>
        <p class="mt-6 max-w-[38ch] text-base leading-relaxed text-body dark:text-white/70">
          {t.plans.free.note}
        </p>
      </section>

      {/*
        The one place the brand gradient appears on this page. A plan pair where
        both cards are equally loud does not recommend anything, and this page
        has a recommendation.
      */}
      <section class="plan-pro relative overflow-hidden rounded-3xl bg-gradient-2 p-7 text-white shadow-input sm:p-9">
        <div class="relative flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold">{t.plans.pro.name}</h2>
          <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-primary">
            {t.plans.pro.trial}
          </span>
        </div>
        <p class="relative mt-6 flex items-baseline gap-2">
          <span class="text-5xl font-bold tabular-nums leading-none">{t.plans.pro.price}</span>
          <span class="text-sm text-white/80">{t.plans.pro.period}</span>
        </p>
        <p class="relative mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
          <span class="tabular-nums text-white/90">{t.plans.pro.second}</span>
          <span class="rounded-full bg-white/15 px-2.5 py-0.5 text-xs">{t.plans.pro.save}</span>
        </p>
        <p class="relative mt-6 max-w-[38ch] text-base leading-relaxed text-white/85">{t.plans.pro.note}</p>
      </section>
    </div>


    {/* The page's one loud line: the price in the unit the reader already buys. */}
    <section class="mt-14 border-y border-stroke py-10 dark:border-stroke-dark">
      <p class="max-w-[22ch] text-3xl font-bold leading-tight text-black dark:text-white sm:text-[40px] sm:leading-[1.1]">
        {t.cansLead}
      </p>
      <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-body">{t.cansBody}</p>
    </section>

    {/*
      The same two columns as the plan pair above: free on the left, Pro on the
      right, in that order all the way down the page. The modes stack instead,
      because tracking and quitting are two audiences and neither of them reads
      the other's rows. Getting this the other way round — a column per mode with
      the tiers inside — made the reader map a new layout onto the cards they had
      just understood.
    */}
    <section class="mt-14">
      <h2 class="text-2xl font-bold text-black dark:text-white sm:text-3xl">{t.compareHeading}</h2>

      {modes.map((mode) => (
        <div class="mt-10">
          <h3 class="flex items-center gap-3 text-[17px] font-semibold text-black dark:text-white">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[12px] bg-primary/10 text-primary dark:bg-primary-light/15 dark:text-primary-light"
              aria-hidden="true"
            >
              <Icon name={mode.icon} size={18} />
            </span>
            {mode.label}
          </h3>

          <div class="mt-4 grid gap-5 md:grid-cols-2">
            <div class="rounded-3xl border border-stroke bg-white p-7 dark:border-stroke-dark dark:bg-dark sm:p-8">
              <p class="text-sm font-semibold text-body dark:text-white/60">{t.colFree}</p>
              <ul class="mt-6 space-y-4">
                {mode.free.map((row) => (
                  <li class="flex items-start gap-3">
                    <span
                      class="mt-[1px] flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-[11px] font-bold text-primary dark:bg-primary-light/20 dark:text-primary-light"
                      aria-hidden="true"
                    >✓</span>
                    <span class="min-w-0 text-[15px] leading-relaxed text-black dark:text-white">{row.label}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/*
              The Pro card from the top of the page, again: same brand gradient,
              same shape, same size as the free card beside it. The rows are
              plain lines with a chip, not boxes inside a box — the free side
              dropped its boxes for the same reason, and two lists that are
              structured differently stop being comparable.

              Exactly `bg-gradient-2`, the same declaration as the card at the
              top, because anything close-but-not-identical reads as a mistake.
              The brand gradient runs through #1FD9FF and white body text on
              that corner is thin, so the rows carry a shadow rather than the
              card carrying a scrim: the colour stays the colour, and the type
              gets its edge back.
            */}
            <div class="pro-panel rounded-3xl bg-gradient-2 p-7 text-white sm:p-8">
              <p class="text-sm font-semibold text-white/85">{t.colPro}</p>
              <ul class="mt-6 space-y-4">
                {mode.pro.map((row) => (
                  <li class="flex items-start gap-3">
                    <span
                      class="mt-[1px] flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white text-[11px] font-bold text-primary"
                      aria-hidden="true"
                    >+</span>
                    <span class="min-w-0 text-[15px] font-medium leading-relaxed text-white">{row.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-black dark:text-white sm:text-3xl">{t.limitsHeading}</h2>
      <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-body">{t.limitsIntro}</p>

      {/* The limits as figures, because a number is the honest form of a limit. */}
      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-stroke bg-stroke dark:border-stroke-dark dark:bg-stroke-dark sm:grid-cols-3">
        {t.limits.map((limit) => (
          <div class="bg-white px-5 py-6 dark:bg-dark">
            <dt class="text-2xl font-bold tabular-nums leading-none text-black dark:text-white">
              {limit.value}
            </dt>
            <dd class="mt-2 text-sm text-body dark:text-white/60">{limit.label}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-6 max-w-[70ch] text-sm leading-relaxed text-body">{t.clarify}</p>
    </section>

    {/*
      The referral counter from the app, rebuilt here rather than screenshotted,
      the same choice the homepage's phone screens make: the threshold is three
      in `react_Breezer/components/homecards/ReferralSection.jsx`, so it is three
      segments here, and the three steps are that screen's own.

      In the site's colours rather than the app's: #1FD9FF against a white card
      is 1.6:1, and a dark app card dropped into a light page reads as a pasted
      screenshot. The structure is the app's, the palette is this page's.

      Nobody is signed in on a marketing page, so the counter is an explanation,
      not a status. It starts empty, fills once when it comes into view, and the
      caption underneath says where the real one lives. Without JavaScript it
      stays at zero of three with the steps numbered, which still explains the
      mechanic.
    */}
    <section class="mt-14 rounded-3xl border border-stroke bg-gray p-7 dark:border-stroke-dark dark:bg-dark sm:p-9">
      <div class="grid gap-8 md:grid-cols-[1fr_minmax(0,330px)] md:items-start md:gap-12">
        <div>
          <h2 class="text-xl font-bold text-black dark:text-white">{t.referralHeading}</h2>
          <p class="mt-4 max-w-[52ch] text-base leading-relaxed text-body dark:text-white/70">
            {t.referralBody}
          </p>
        </div>

        <div
          class="rounded-2xl border border-stroke bg-white p-5 dark:border-stroke-dark dark:bg-black/25"
          data-referral
        >
          <div class="flex items-baseline justify-between gap-3">
            <p class="text-sm font-semibold text-black dark:text-white">{t.referralDemo.label}</p>
            <p class="text-sm font-bold tabular-nums text-primary dark:text-primary-light">
              <span data-referral-count>0</span> / 3
            </p>
          </div>

          <div class="mt-3 flex gap-2">
            {[0, 1, 2].map(() => (
              <span
                class="referral-seg relative h-2 flex-1 overflow-hidden rounded-full bg-stroke dark:bg-white/10"
                data-referral-seg
              >
                <span class="referral-fill absolute inset-0"></span>
              </span>
            ))}
          </div>

          <ol class="mt-6 space-y-3">
            {t.referralDemo.steps.map((step, i) => (
              <li class="referral-step flex items-start gap-3" data-referral-step={i + 1}>
                <span
                  class="referral-badge mt-[1px] flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-stroke text-[11px] font-bold text-body dark:bg-white/10 dark:text-white/60"
                  aria-hidden="true"
                >
                  <span data-referral-num>{i + 1}</span>
                  <span data-referral-check hidden>✓</span>
                </span>
                <span class="referral-label min-w-0 text-[14px] leading-relaxed text-body dark:text-white/70">
                  {step}
                </span>
              </li>
            ))}
          </ol>

          <p class="mt-5 text-xs leading-relaxed text-body/80 dark:text-white/50">
            {t.referralDemo.caption}
          </p>
        </div>
      </div>
    </section>

    {/*
      The last argument before the questions, and the only first-person passage
      on the page: somebody who has just read where the free version ends is
      owed the reason there is a price at all, and that reason is a person's,
      not a company's.

      Not a card. Three cards in a row and this one would read as the third
      feature box rather than as somebody talking; a rule and a portrait is the
      quietest way to change who is speaking. Not a `blockquote` either, unlike
      the homepage's version of this: nothing is being quoted from elsewhere,
      the eyebrow names the speaker, and the section still owes the page an
      `h2` like every other one.
    */}
    <section class="mt-14 border-t border-stroke pt-12 dark:border-stroke-dark">
      <p class="text-sm font-medium text-primary dark:text-primary-light">{t.founderEyebrow}</p>
      <FounderPortrait class="mt-6" />
      <h2 class="mt-6 text-2xl font-bold text-black dark:text-white sm:text-3xl">{t.founderHeading}</h2>
      <div class="mt-5 max-w-[62ch] space-y-4 text-base leading-relaxed text-body">
        {t.founderBody.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-black dark:text-white sm:text-3xl">{t.faqHeading}</h2>
      {/*
        The site's own FAQ mechanics: `main.js` toggles `.faq.active`, and the
        same array is what the page emits as FAQPage schema.
      */}
      <div class="faqs mt-8 rounded-3xl border border-stroke bg-white px-6 dark:border-stroke-dark dark:bg-dark">
        {t.faq.map((item, i) => (
          <div class:list={['faq border-b border-stroke last-of-type:border-none dark:border-stroke-dark', i === 0 && 'active']}>
            <button
              class="faq-btn relative flex w-full justify-between py-6 px-[18px] text-left text-base font-medium text-black dark:text-white sm:px-[26px] sm:text-lg"
              aria-expanded={i === 0 ? 'true' : 'false'}
            >
              {item.q}
            </button>
            <div class="faq-content h-auto overflow-hidden border-t border-stroke px-[18px] dark:border-stroke-dark sm:px-[26px]">
              <p class="text-base leading-relaxed text-body">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14 text-center">
      <h2 class="mx-auto max-w-[20ch] text-3xl font-bold leading-tight text-black dark:text-white sm:text-4xl">
        {t.ctaHeading}
      </h2>
      <StoreButtons lang={lang} class="mt-8 justify-center" />
      <p class="mx-auto mt-8 max-w-[62ch] text-xs leading-relaxed text-body/80 dark:text-white/50">
        {t.storeNote}
      </p>
    </section>
  </div>
</main>

<style>
  /*
    The referral counter's fill. Each segment is a track with the colour already
    painted inside it and scaled away: `main.js` sets `data-filled` and the fill
    grows from the left, on the compositor, instead of a colour swapping in.

    Flat #1FD9FF, the light end of the brand gradient and the exact colour the
    app paints these segments. It is the one thing on this page taken from the
    app's palette rather than the site's: a gradient across a 2px bar reads as
    two different fills across three segments, and the state is carried in words
    by the counter beside it, which is in `primary` and legible.
  */
  .referral-fill {
    background-color: #1fd9ff;
    transform: scaleX(0);
    transform-origin: left center;
  }
  .referral-seg[data-filled] .referral-fill {
    transform: scaleX(1);
  }

  /*
    The last step is the reward, so it is the one that changes when the counter
    fills: the number becomes a tick and the line stops being grey. Written out
    rather than composed from utilities, because the state sits on the row and
    the change happens two elements down, which no Tailwind 3.1 variant reaches.
  */
  .referral-step[data-done] .referral-badge {
    background-color: rgba(13, 107, 205, 0.12);
    color: #0d6bcd;
  }
  .referral-step[data-done] .referral-label {
    color: #161622;
  }
  :global(.dark) .referral-step[data-done] .referral-badge {
    background-color: rgba(79, 169, 242, 0.18);
    color: #4fa9f2;
  }
  :global(.dark) .referral-step[data-done] .referral-label {
    color: #ffffff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .referral-fill {
      transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .referral-badge,
    .referral-label {
      transition:
        background-color 300ms ease,
        color 300ms ease;
    }
  }

  /*
    Body text on the brand gradient. Its light end is #1FD9FF, where white type
    at this size loses its edge; a shadow the colour of the gradient's own dark
    end gives it back without touching the colour of the card, which is the
    thing that makes the Pro side recognisable.
  */
  .pro-panel li span:last-child,
  .pro-panel > p {
    text-shadow: 0 1px 2px rgba(6, 42, 86, 0.38);
  }

  /*
    One sheen, once, when the card arrives. A plan card is the one element on
    this page somebody is asked to trust with money, and a surface that catches
    the light reads as a made object rather than a coloured rectangle.

    It runs once and then never again: a loop would turn the thing being sold
    into a thing that blinks. Nothing else on the page moves, which is what
    makes this readable as emphasis instead of as decoration.
  */
  @media (prefers-reduced-motion: no-preference) {
    .plan-pro::after {
      content: '';
      position: absolute;
      inset: -40% -10%;
      pointer-events: none;
      background: linear-gradient(
        100deg,
        transparent 38%,
        rgba(255, 255, 255, 0.28) 48%,
        rgba(255, 255, 255, 0.1) 54%,
        transparent 62%
      );
      transform: translateX(-130%);
      animation: plan-sheen 1400ms cubic-bezier(0.22, 1, 0.36, 1) 500ms 1 forwards;
    }

    @keyframes plan-sheen {
      to {
        transform: translateX(130%);
      }
    }
  }
</style>
