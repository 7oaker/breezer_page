---
/**
 * The widget's log icon. The app uses Apple's SF Symbol `eraser.fill`, which
 * cannot ship on a web page, so this draws the same silhouette: a tilted block
 * with a band across one end. It reads as a snus pouch, which is why the widget
 * uses it.
 */
interface Props {
  size: number;
  color: string;
}
const { size, color } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <g transform="rotate(-35 12 12)" fill={color}>
    <rect x="2.5" y="7" width="19" height="10" rx="2.6"></rect>
  </g>
  <g transform="rotate(-35 12 12)">
    <rect x="13.4" y="7" width="1.6" height="10" fill="rgb(255 255 255 / 0.55)"></rect>
  </g>
</svg>
