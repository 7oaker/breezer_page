---
/**
 * The craving help for the store's `craving` image: `react_Breezer/app/(tabs)/urge.jsx`
 * on its second step, the moment after the craving has been rated, when the
 * app offers what to do for the next few minutes.
 *
 * Why this step and not the breathing circle: the image says "help when the
 * craving comes", and this is the one screen where all of the help is visible
 * at once, in the app's own order and words, under its own line ("Let us get
 * through the next minutes"). The circle alone reads as any meditation app.
 *
 * Everything is the app's: the four TOOLS with their Ionicons and colours, the
 * five StepDots with the second one active, the strings from `urge.*`. Sizes are
 * the app's points times 261/393 (AppScreen's contract): `p-4` 16 -> 10.6px,
 * `w-11` 44 -> 29px, `text-2xl` 24 -> 16px, `text-base` 16 -> 10.6px,
 * `text-sm` 14 -> 9px, `text-xs` 12 -> 8px.
 *
 * Nothing sits under the four cards because nothing does in the app: that step
 * is a ScrollView with the list and no button.
 *
 * Icons are Ionicons outlines, the glyphs out of the app's own
 * `@expo/vector-icons` font (Ionicons.ttf), flipped into a 512 box.
 */
import AppScreen from '../../home/AppScreen.astro';
import StatusBar from '../StatusBar.astro';
import { appLocale } from '../../../lib/appLocale';

interface Props {
  lang: string;
  page: 'default' | 'track' | 'quit';
  os: 'ios' | 'android';
  scale: number;
}
const { lang, os, scale } = Astro.props;
const tr = appLocale(lang);

/** Ionicons glyphs, from the font the app ships (`@expo/vector-icons`). */
const ION = {
  'game-controller-outline':
