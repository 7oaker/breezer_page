---
/**
 * The feature list that sits beside a phone mockup.
 *
 * It is built to look like the app's own list rows — tinted square icon chip,
 * title, one quiet line under it, hairline between rows — rather than like a
 * column of marketing bullets. The section already shows the app running inside
 * a device two hundred pixels to the right; the list is the same interface
 * unpacked at reading size, which is why the row is the unit and not a card.
 * The previous treatment (a 60px outlined circle per item, 30px of air between
 * them) said nothing about the product and read as a stock template.
 *
 * `lead` marks the one row that carries the section's claim. It gets the solid
 * chip, everything else stays quiet: one accent per block, not five.
 *
 * Visible on every width. The old markup was `hidden md:block`, so on a phone
 * the page showed two device mockups and no feature text at all — the audience
 * most likely to be reading it on the device they would install on.
 */
import Icon from '../Icon.astro';

export interface Feature {
  /** Key from `Icon.astro`'s inlined set. */
  icon: string;
  title: string;
  text: string;
  /** The defining feature of the block. At most one per list. */
  lead?: boolean;
}

interface Props {
  features: Feature[];
  class?: string;
}
const { features, class: className = '' } = Astro.props;
---

<ul
  class:list={[
    'divide-y divide-stroke overflow-hidden rounded-2xl border border-stroke bg-gray dark:divide-stroke-dark dark:border-stroke-dark dark:bg-dark',
    className,
  ]}
>
  {features.map((feature) => (
    <li class="flex items-start gap-4 px-5 py-[18px] sm:px-6">
      <span
        class:list={[
          'flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px]',
          feature.lead
            ? 'bg-primary text-white'
            : 'bg-primary/10 text-primary dark:bg-primary-light/15 dark:text-primary-light',
        ]}
        aria-hidden="true"
      >
        <Icon name={feature.icon} size={22} />
      </span>
      <div class="min-w-0 pt-[3px]">
        <h3 class="text-[17px] font-semibold leading-tight text-black dark:text-white">
          {feature.title}
        </h3>
        <p class="mt-1 max-w-[46ch] text-sm leading-relaxed text-body dark:text-white/60">
          {feature.text}
        </p>
      </div>
    </li>
  ))}
</ul>
