---
/**
 * One carousel of app screenshots: a static device frame with the slides
 * travelling underneath it.
 *
 * Extracted from `Home.astro` when the screens section gained the Tracking /
 * Quitting filter, because a filter that swaps slides in and out of a running
 * Swiper loop is the fiddly way to do it. Two instances that show one at a time
 * cannot get their loop state wrong, and each mode keeps its own position.
 *
 * The frame and the backplate are absolutely positioned over the whole
 * container and sized to exactly one slide, so their box has to match Swiper's
 * arithmetic: `(container - spaceBetween * (perView - 1)) / perView`, which is
 * `(100% - 80px) / 3` at md and up and the full width below it. `w-1/3` looks
 * right only at exactly 1000px.
 *
 * The nav buttons live inside this element and are found by `main.js` through
 * this element, not through a document-wide selector — with two carousels on
 * the page, a document-wide `.swiper-button-next` would hand both instances the
 * same pair of buttons.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneFrame from '../PhoneFrame.astro';
import img_mobile_frame from '../../assets/images/screens/mobile-frame.png';

interface Props {
  slides: { src: ImageMetadata; alt: string }[];
  /** Names the carousel for screen readers, e.g. the tab it belongs to. */
  label: string;
  prevLabel: string;
  nextLabel: string;
}
const { slides, label, prevLabel, nextLabel } = Astro.props;
---

<div class="swiper mySwiper relative z-20" role="group" aria-label={label}>
  {/*
    A dark panel sitting in the screen window behind the slides. The
    40px gap between two slides travels through the window on every
    transition; without this it showed as page background, so mid-swipe
    the device looked switched off. Now the gap reads as screen.
  */}
  <div
    class="pointer-events-none absolute top-0 left-0 right-0 z-0 mx-auto w-full md:w-[calc((100%-80px)/3)]"
    aria-hidden="true"
  >
    <div class="relative mx-auto aspect-[295/594] w-full max-w-[295px]">
      <div class="absolute inset-y-[2.357%] inset-x-[5.763%] rounded-[7%] bg-[#0F1117]"></div>
    </div>
  </div>
  <div
    class="pointer-events-none absolute top-0 left-0 right-0 z-50 mx-auto w-full md:w-[calc((100%-80px)/3)]"
  >
    <Image src={img_mobile_frame} width={295} height={594}
      alt=""
      aria-hidden="true"
      class="mx-auto w-full max-w-[295px]" loading="lazy" decoding="async" />
  </div>
  <div class="swiper-wrapper relative z-10">
    {slides.map((slide) => (
      <div class="swiper-slide">
        <PhoneFrame src={slide.src} alt={slide.alt} screenOnly />
      </div>
    ))}
  </div>
  <div class="flex items-center justify-center space-x-4 pt-20">
    <button class="swiper-button-prev" type="button" aria-label={prevLabel}>
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        {/*
          The clip path both arrows carried was a 20x20 rect over a 20x20
          viewBox, so it clipped nothing — and its id would now appear twice in
          the document, once per carousel.
        */}
        <path
          d="M6.52334 10.8334L10.9933 15.3034L9.81501 16.4817L3.33334 10L9.815 3.51836L10.9933 4.69669L6.52334 9.16669L16.6667 9.16669L16.6667 10.8334L6.52334 10.8334Z"
          fill="currentColor"
        />
      </svg>
    </button>
    <button class="swiper-button-next" type="button" aria-label={nextLabel}>
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M13.4767 9.16664L9.00667 4.69664L10.185 3.51831L16.6667 9.99998L10.185 16.4816L9.00667 15.3033L13.4767 10.8333H3.33334V9.16664H13.4767Z"
          fill="currentColor"
        />
      </svg>
    </button>
  </div>
</div>
