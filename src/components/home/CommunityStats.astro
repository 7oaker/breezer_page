---
/**
 * The community numbers band, under the hero.
 *
 * The figures come from one Appwrite row that the app's weekly `community-stats`
 * function writes, fetched at build time (`src/data/communityStats.ts`). Rendering them
 * server side is the point: no key in the browser, no request on load, no number
 * appearing late and pushing the page around.
 *
 * Three of the five keep moving between builds, because the row carries a per-day rate
 * next to each of them. `src/scripts/community-stats.js` carries those forward from
 * `computedAt`, so a page built on Sunday still shows the right figure on Friday. The
 * server-rendered value is already projected to build time, which is what somebody with
 * JavaScript off sees.
 *
 * No row means no band. There is no hardcoded fallback on purpose: a stale invented
 * number on a public page is the thing this whole mechanism exists to avoid.
 */
import type { UI } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';
import { getCommunityStats, projectStats } from '../../data/communityStats';

interface Props {
  t: UI;
  lang: Lang;
}
const { t, lang } = Astro.props;

const stats = await getCommunityStats();
const live = stats ? projectStats(stats) : null;

const numberFormat = new Intl.NumberFormat(lang);
const moneyFormat = new Intl.NumberFormat(lang, {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
});

// `base` and `rate` are what the ticker needs; a tile without a rate simply stands still.
const tiles = stats && live
  ? [
      { label: t.stat_members, value: numberFormat.format(stats.members), base: stats.members, rate: 0, kind: 'count' },
      { label: t.stat_pouches_tracked, value: numberFormat.format(stats.pouchesTracked), base: stats.pouchesTracked, rate: 0, kind: 'count' },
      { label: t.stat_days_without_snus, value: numberFormat.format(live.daysWithoutSnus), base: stats.daysWithoutSnus, rate: stats.quitters, kind: 'count' },
      { label: t.stat_money_saved, value: moneyFormat.format(live.moneySaved), base: stats.moneySaved, rate: stats.rateMoneyPerDay, kind: 'money' },
      { label: t.stat_chat_messages, value: numberFormat.format(stats.chatMessages), base: stats.chatMessages, rate: 0, kind: 'count' },
    ]
  : [];
---

{stats && (
  <section id="community-numbers" class="relative z-10 pt-[70px]">
    <div class="container">
      {/*
        The heading is an eyebrow, not a section title: the band sits directly under the
        hero's claim and reads as proof of it. Small caps carry the label without
        competing with the figures, which are the only thing here worth looking at.
      */}
      <h2 class="mb-7 text-center text-[11px] font-medium uppercase tracking-[0.18em] text-body dark:text-white/50">
        {t.community_numbers_title}
      </h2>

      <div
        class="wow fadeInUp"
        data-wow-delay=".2s"
        data-community-stats
        data-locale={lang}
        data-computed-at={stats.computedAt}
      >
        <dl class="grid grid-cols-2 gap-x-6 gap-y-9 text-center sm:grid-cols-3 lg:grid-cols-5">
          {tiles.map((tile) => (
            <div>
              <dd
                class="text-3xl font-bold tabular-nums leading-none text-black dark:text-white sm:text-[34px] xl:text-[38px]"
                data-stat-value
                data-base={tile.base}
                data-rate={tile.rate}
                data-kind={tile.kind}
              >
                {tile.value}
              </dd>
              <dt class="mt-2.5 text-[11px] font-medium uppercase tracking-[0.14em] text-body dark:text-white/60">
                {tile.label}
              </dt>
            </div>
          ))}
        </dl>

        <p class="mx-auto mt-9 max-w-[620px] text-center text-xs leading-relaxed text-body/80 dark:text-white/50">
          <span class="font-medium text-black/70 dark:text-white/70">{t.community_numbers_claim}:</span>{' '}
          {t.community_numbers_note}
        </p>
      </div>
    </div>
  </section>
)}
