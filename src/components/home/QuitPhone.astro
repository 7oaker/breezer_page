---
/**
 * The app's quit-mode home screen, rebuilt as real DOM so the clock actually
 * runs.
 *
 * This replaced a flat screenshot. The screen's whole point is that a number is
 * moving in your favour every second you do not take a pouch, and a still
 * freezes exactly the thing that makes it work. Nothing here is operable — the
 * visitor watches it — but the seconds tick, the minutes roll over, and
 * avoided / saved / gained climb with them, which is what
 * `react_Breezer/components/homecards/QuittingView.jsx` does with a single
 * one-second interval that recomputes the whole screen from the elapsed
 * duration.
 *
 * The arithmetic is that file's `computeQuittingSavings` verbatim
 * (`utility/helperFunctions.js:46-80`) at the app's defaults. Geometry follows
 * AppScreen's contract; landmarks were measured off
 * `screens/new/quitting-home.png`.
 *
 * NAMES. The source screenshot shows real Breezer users on the leaderboard and
 * a real account name in the congratulations line. Publishing those would put
 * real people on a public marketing page without their consent, so every name
 * here is invented. The day counts and the avatar colours are the screenshot's.
 */
import { Image } from 'astro:assets';
import AppScreen from './AppScreen.astro';
import type { UI } from '../../i18n/ui';
import { fill } from '../../i18n/ui';
import quitBg from '../../assets/images/app/quit-bg.jpg';
import pouch from '../../assets/images/app/logo-small.png';
import appIcon from '../../assets/images/app/app-icon-dark.png';

interface Props {
  t: UI;
  class?: string;
}
const { t, class: className = '' } = Astro.props;

/**
 * How long the sample account has been snus free. Anchored relative to page
 * load rather than to a date baked into the HTML — a fixed start date would
 * read "24 Days" today and "300 Days" after a few months without a rebuild.
 *
 * Under a month on purpose: the YEAR and MONTH chips both read zero, so the
 * hours and minutes are what the eye lands on and the clock is visibly doing
 * something. The screenshot's 143 days pushed the interesting digits into
 * MONTH, where nothing moves while anyone is watching.
 */
const QUIT_SECONDS = 24 * 86400 + 7 * 3600 + 12 * 60 + 40;

/** The app's habit defaults, which are what the screenshot's numbers imply. */
const HABIT = { dailyLimit: 10, pricePerPack: 6, snusPerPack: 24, minutesPerSnus: 30 };

/** `computeQuittingSavings`, verbatim. Duplicated in quit-phone.js for ticking. */
function savingsFor(elapsedSeconds: number) {
  const days = elapsedSeconds / 86400;
  const expected = Math.max(0, days * HABIT.dailyLimit);
  const costPerSnus = HABIT.pricePerPack / HABIT.snusPerPack;
  return {
    avoided: Math.floor(expected),
    saved: expected * costPerSnus,
    minutesGained: Math.round(expected * HABIT.minutesPerSnus),
  };
}

/** The app: `Nd Nh` once a day has accrued, else `Nh Nm`. */
function formatGained(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const days = Math.floor(hours / 24);
  return days > 0 ? `${days}d ${hours % 24}h` : `${hours}h ${minutes % 60}m`;
}

const seedSavings = savingsFor(QUIT_SECONDS);
const totalDays = Math.floor(QUIT_SECONDS / 86400);

/**
 * The six chips are a calendar decomposition of the same span the big number
 * floors, which is why `0y 4m 21d` and `143 Days` sit on the same card without
 * contradicting each other.
 */
function decompose(from: Date, to: Date) {
  let years = to.getFullYear() - from.getFullYear();
  let months = to.getMonth() - from.getMonth();
  let days = to.getDate() - from.getDate();
  let hours = to.getHours() - from.getHours();
  let minutes = to.getMinutes() - from.getMinutes();
  let seconds = to.getSeconds() - from.getSeconds();
  if (seconds < 0) (seconds += 60), (minutes -= 1);
  if (minutes < 0) (minutes += 60), (hours -= 1);
  if (hours < 0) (hours += 24), (days -= 1);
  if (days < 0) {
    days += new Date(to.getFullYear(), to.getMonth(), 0).getDate();
    months -= 1;
  }
  if (months < 0) (months += 12), (years -= 1);
  return { years, months, days, hours, minutes, seconds };
}

const buildNow = new Date();
const seedChips = decompose(new Date(buildNow.getTime() - QUIT_SECONDS * 1000), buildNow);

/**
 * The app's milestone lists evaluated at the seed above. Constants rather than
 * a live computation because neither can change inside a visit: health is
 * `[1,3,7,14,30,90,180,365,1825]` filtered by days elapsed, so 24 days clears
 * the first four. Achievements is a 24-target list over days, pouches, packs,
 * money and hours gained; at 243 pouches, 60.75 € and 121 hours everything is
 * met except the 30/90/180/365-day marks, 500 pouches and 100/250 €.
 */
const HEALTH_DONE = 4;
const HEALTH_TOTAL = 9;
const ACHIEVEMENTS_DONE = 17;
const ACHIEVEMENTS_TOTAL = 24;

/**
 * The journey tile, which replaced the quitters ranking in the app — a board on
 * which nobody could ever move, because days clean grow by one a day for
 * everybody. `JourneySection.jsx` draws the path in miniature instead: filled
 * behind you, hollow ahead, a ring where you are standing, and the three
 * milestones that come next.
 *
 * These five rungs and three milestones are not invented. They are what
 * `buildHomeCard({ days: 24, userHabit: HABIT, hasProAccess: true })` in
 * `react_Breezer/lib/quitJourney.js` returns, which is the same function the app
 * calls — day 20 and 24 are money and pouch targets the seeded habit reaches
 * there, 25 is a withdrawal symptom easing, 30 is the fifth health improvement,
 * 40 is 100 EUR saved. Changing QUIT_SECONDS or HABIT means running that
 * function again rather than nudging these by hand.
 *
 * `tone` is the app's `spineTone`: green for what happened to your body, blue
 * for what you earned. `kind` is its `primaryKind`, which decides the icon and
 * can differ from the tone on a day that carries both.
 *
 * Static, like the ranking it replaces. The clock above it ticks, but a rung
 * only moves after a whole day, and the page would have to stay open for the
 * rest of one for that to matter.
 */
const RUNGS: { day: number; tone: 'earned' | 'health'; reached: boolean }[] = [
  { day: 20, tone: 'earned', reached: true },
  { day: 24, tone: 'earned', reached: true },
  { day: 25, tone: 'health', reached: false },
  { day: 30, tone: 'health', reached: false },
  { day: 40, tone: 'earned', reached: false },
];

/** The first rung still ahead: where the quitter is standing on the ladder. */
const NEXT_RUNG = RUNGS.findIndex((rung) => !rung.reached);

const NEXT = [
  { kind: 'symptom', label: t.app_quit_journey_irritability, inDays: 1 },
  { kind: 'health', label: t.app_quit_journey_nicotine_free, inDays: 6 },
  { kind: 'achievement', label: `€100 ${t.app_quit_saved}`, inDays: 16 },
];

/** The app's `journey.inDays`, whose one/other split i18next handles for it. */
const inDays = (count: number) =>
  count === 1 ? t.app_quit_journey_in_day : fill(t.app_quit_journey_in_days, { count });

/** `spineTone` as the two colours the path uses, at the opacities it uses them. */
const DOT = { earned: 'bg-[#1FD9FF]/50', health: 'bg-[#22c55e]/60' };
const LINE = { earned: 'bg-[#1FD9FF]/30', health: 'bg-[#22c55e]/25' };

const CHIPS = [
  { value: seedChips.years, label: t.app_quit_label_year, key: 'years' },
  { value: seedChips.months, label: t.app_quit_label_month, key: 'months' },
  { value: seedChips.days, label: t.app_quit_label_day, key: 'days' },
  { value: seedChips.hours, label: t.app_quit_label_hour, key: 'hours' },
  { value: seedChips.minutes, label: t.app_quit_label_min, key: 'minutes' },
  { value: seedChips.seconds, label: t.app_quit_label_sec, key: 'seconds' },
];

const CONFIG = { quitSeconds: QUIT_SECONDS, habit: HABIT };
---

<AppScreen class={className} data-quit-phone data-config={JSON.stringify(CONFIG)}>
  <p class="sr-only">{t.app_quit_demo_caption}</p>

  {/* Status bar */}
  <div
    class="flex h-[26px] shrink-0 items-start justify-between px-[14px] pt-[13px] text-[10px] font-semibold leading-[11px] text-white"
    aria-hidden="true"
  >
    <span>07:04</span>
    <span class="flex items-center gap-[3px]">
      <svg width="14" height="9" viewBox="0 0 14 9" fill="currentColor"
        ><rect x="0" y="6" width="2.4" height="3" rx=".6"></rect><rect
          x="3.6"
          y="4"
          width="2.4"
          height="5"
          rx=".6"></rect><rect x="7.2" y="2" width="2.4" height="7" rx=".6"></rect><rect
          x="10.8"
          y="0"
          width="2.4"
          height="9"
          rx=".6"></rect></svg
      >
      <svg width="12" height="9" viewBox="0 0 16 12" fill="none" stroke="currentColor"
        ><path d="M1 4a10 10 0 0 1 14 0" stroke-width="1.6" stroke-linecap="round"></path><path
          d="M4 7a6 6 0 0 1 8 0"
          stroke-width="1.6"
          stroke-linecap="round"></path><circle cx="8" cy="10.2" r="1.1" fill="currentColor"
          stroke="none"></circle></svg
      >
      <span class="rounded-[3px] border border-white/50 px-[3px] text-[8px] font-bold leading-[10px]"
        >100</span
      >
    </span>
  </div>

  {/* Top bar. Streak 1, so the flame is still the accent cyan. */}
  <div class="mt-[19px] flex h-[20px] shrink-0 items-center justify-between px-[12px]">
    <div class="flex items-center gap-[6px]">
      <span class="text-[16px] font-bold leading-none text-white">1</span>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="#1FD9FF" aria-hidden="true"
        ><path
          d="M12 2c.5 3.2-1.4 4.6-2.8 6C7.6 9.6 6 11.2 6 14a6 6 0 0 0 12 0c0-3-1.6-4.8-3-6.4-.8.9-1.6 1.3-2.3 1-.9-.4-1.1-1.7-.4-3.4C12.7 4 12.6 2.9 12 2Zm0 11.2c1.3 1 1.9 1.9 1.9 2.9a1.9 1.9 0 0 1-3.8 0c0-1 .6-1.9 1.9-2.9Z"
        ></path></svg
      >
    </div>
    <div class="flex items-center gap-[13px] text-[#9ca3af]" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M12 3v12M12 3 8 7M12 3l4 4" stroke-linecap="round" stroke-linejoin="round"
        ></path><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" stroke-linecap="round"></path></svg
      >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 1.8c-3.6 0-8 1.8-8 4.6V21h16v-2.6c0-2.8-4.4-4.6-8-4.6Z"
        ></path></svg
      >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="m19.4 13-.1-1 2-1.6-2-3.4-2.4.9c-.5-.4-1.1-.7-1.7-1L14.8 4h-4l-.4 2.9c-.6.3-1.2.6-1.7 1l-2.4-.9-2 3.4 2 1.6a7.6 7.6 0 0 0 0 2l-2 1.6 2 3.4 2.4-.9c.5.4 1.1.7 1.7 1l.4 2.9h4l.4-2.9c.6-.3 1.2-.6 1.7-1l2.4.9 2-3.4-2-1.6.1-1Zm-6.6 3.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Z"
        ></path></svg
      >
    </div>
  </div>

  <p class="mt-[14px] shrink-0 text-center text-[16px] font-bold leading-[20px] text-white">
    {fill(t.app_quit_congrats, { name: 'Klaus' })}
  </p>

  {/*
    Hero card over the app's own photo. No scrim: the app has none either, and
    the only darkening is the chips' and tiles' own translucent fill.
  */}
  <div class="relative mx-[11px] mt-[7px] h-[176px] shrink-0 overflow-hidden rounded-[8px]">
    <Image
      src={quitBg}
      width={480}
      height={312}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="relative flex h-full flex-col p-[8px]">
      <p class="text-center text-[9px] font-extrabold leading-[11px] text-white">
        {t.app_quit_snus_free_for}
      </p>
      <p class="mt-[2px] text-center text-[32px] font-extrabold leading-[38px] text-white"
        ><span data-quit-total-days>{totalDays}</span> {t.app_quit_days}</p
      >

      <div class="mt-[6px] flex justify-between">
        {
          CHIPS.map((chip) => (
            <span class="flex w-[16%] flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[5px]">
              <span
                class="text-[9px] font-bold leading-[11px] text-white"
                data-quit-chip={chip.key}
              >
                {chip.value}
              </span>
              <span class="text-[6px] leading-[8px] text-[#d1d5db]">{chip.label}</span>
            </span>
          ))
        }
      </div>

      <div class="mt-auto flex gap-[3px]">
        <span class="flex flex-1 flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[6px]">
          <span class="flex items-center gap-[3px] text-[13px] font-bold leading-[15px] text-white">
            <span data-quit-avoided>{seedSavings.avoided}</span>
            <Image
              src={pouch}
              width={26}
              height={26}
              alt=""
              aria-hidden="true"
              class="h-[13px] w-[13px]"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="mt-[2px] text-[8px] leading-[10px] text-[#d1d5db]">{t.app_quit_avoided}</span>
        </span>
        <span class="flex flex-1 flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[6px]">
          <span class="text-[13px] font-bold leading-[15px] text-white" data-quit-saved
            >{seedSavings.saved.toFixed(1)} €</span
          >
          <span class="mt-[2px] text-[8px] leading-[10px] text-[#d1d5db]">{t.app_quit_saved}</span>
        </span>
        <span class="flex flex-1 flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[6px]">
          <span class="text-[13px] font-bold leading-[15px] text-white" data-quit-gained
            >{formatGained(seedSavings.minutesGained)}</span
          >
          <span class="mt-[2px] text-[8px] leading-[10px] text-[#d1d5db]">{t.app_quit_gained}</span>
        </span>
      </div>
    </div>
  </div>

  {/* Health and Achievements */}
  <div class="mx-[8px] mt-[18px] flex h-[78px] shrink-0 gap-[6px]">
    <div class="flex w-1/2 flex-col rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] p-[8px]">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold leading-none text-white">{t.app_quit_health}</span>
        <span class="rounded-[5px] bg-[#ef4444]/15 p-[4px]" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="#6b7280"
            ><path
              d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.6 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9Z"
            ></path></svg
          >
        </span>
      </div>
      <p class="mt-[6px] flex items-baseline">
        <span class="text-[12px] font-bold leading-none text-white">{HEALTH_DONE}</span>
        <span class="text-[8px] leading-none text-[#6b7280]">/{HEALTH_TOTAL}</span>
        <span class="ml-[4px] text-[8px] leading-none text-[#9ca3af]">{t.app_quit_completed}</span>
      </p>
      <span class="mt-auto flex items-center gap-[2px] text-[8px] font-medium leading-none text-[#1FD9FF]">
        {t.app_quit_view}
        <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"
          ><path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </span>
    </div>

    <div class="flex w-1/2 flex-col rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] p-[8px]">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold leading-none text-white">{t.app_quit_achievements}</span>
        <span class="rounded-[5px] bg-[#facc15]/15 p-[4px]" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="#6b7280"
            ><path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2Zm-3 11-2 9 5-3 5 3-2-9a7 7 0 0 1-6 0Z"
            ></path></svg
          >
        </span>
      </div>
      <p class="mt-[6px] flex items-baseline">
        <span class="text-[12px] font-bold leading-none text-white">{ACHIEVEMENTS_DONE}</span>
        <span class="text-[8px] leading-none text-[#6b7280]">/{ACHIEVEMENTS_TOTAL}</span>
        <span class="ml-[4px] text-[8px] leading-none text-[#9ca3af]">{t.app_quit_unlocked}</span>
      </p>
      <span class="mt-auto flex items-center gap-[2px] text-[8px] font-medium leading-none text-[#1FD9FF]">
        {t.app_quit_view}
        <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"
          ><path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </span>
    </div>
  </div>

  {/*
    Urge and Slip. Each sits under the tile it belongs to — craving under Health,
    slip under Achievements — so the column above says what the button is about
    before the label does. Deliberately quiet: nothing here is a celebration.

    Not operable, like everything else on this screen. The two real buttons open
    a form, and a form is not a thing to mock up on a marketing page.
  */}
  <div class="mx-[5px] mt-[6px] flex h-[27px] shrink-0 gap-[6px]" aria-hidden="true">
    <span
      class="flex w-1/2 items-center justify-center gap-[3px] rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] text-[9px] font-semibold leading-none text-[#1FD9FF]"
    >
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        ><path d="M12 5v14M5 12h14" stroke-linecap="round"></path></svg
      >
      {t.app_quit_urge}
    </span>
    <span
      class="flex w-1/2 items-center justify-center gap-[3px] rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] text-[9px] font-semibold leading-none text-[#fb7185]"
    >
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        ><path d="M12 5v14M5 12h14" stroke-linecap="round"></path></svg
      >
      {t.app_quit_slip}
    </span>
  </div>

  {/*
    Your Journey. It replaces both the share pill and the quitters ranking that
    stood here: the pill was a row of chrome, and the board it sat above ranked
    strangers on a number that only ever counts up.

    The strip is the path itself in miniature, which is the whole idea of it — a
    card that opens a path should look like one rather than like another number
    in a box. Filled behind, hollow ahead, a ring on the rung being walked
    towards, and the same green the health steps use on the screen above.
  */}
  <div
    class="mx-[8px] mt-[12px] shrink-0 rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] p-[8px]"
  >
    <div class="flex items-center justify-between">
      <span class="flex items-center gap-[5px] text-[11px] font-bold leading-none text-white">
        {/* Footsteps, the app's icon for this card: two prints walking away. */}
        <svg width="11" height="11" viewBox="0 0 24 24" fill="#6b7280" aria-hidden="true"
          ><ellipse cx="7" cy="7" rx="3" ry="4.2"></ellipse><ellipse cx="7" cy="13.8" rx="2.2" ry="1.8"
          ></ellipse><ellipse cx="17" cy="11" rx="3" ry="4.2"></ellipse><ellipse
            cx="17"
            cy="17.8"
            rx="2.2"
            ry="1.8"></ellipse></svg
        >
        {t.app_quit_journey}
      </span>
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#1FD9FF" stroke-width="3" aria-hidden="true"
        ><path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </div>

    {/*
      The day under each dot, bare and in the weight the spine itself uses,
      because a row of dots is a shape rather than a scale: it shows that
      something is coming without saying whether it is tomorrow or in a year.
      No total here either — that is the 32px number two centimetres above, and
      these are the days the rungs sit on, which is what the counter cannot say.
    */}
    <div class="mt-[9px] flex items-start" aria-hidden="true">
      {
        RUNGS.map((rung, i) => {
          const isNext = i === NEXT_RUNG;
          const prev = i > 0 ? RUNGS[i - 1] : null;
          return (
            <>
              {/* A segment belongs to the dot on its left: it is the stretch
                  already walked, so it takes that dot's colour. Nudged to the
                  dots' middle rather than centred on a column the day numbers
                  made taller. */}
              {prev ? (
                <span
                  class:list={[
                    'mt-[3px] h-[1.5px] flex-1',
                    prev.reached ? LINE[prev.tone] : 'bg-[#374151]/40',
                  ]}
                />
              ) : null}
              <span class="flex w-[20px] shrink-0 flex-col items-center">
                {/* Fixed height: the ring is two pixels wider than a plain dot,
                    and the numbers would otherwise sit at two heights. */}
                <span class="flex h-[8px] items-center justify-center">
                  <span
                    class:list={[
                      'rounded-full',
                      isNext
                        ? 'h-[7px] w-[7px] border-[1.5px] border-[#1FD9FF] bg-[#232533]'
                        : ['h-[5px] w-[5px]', rung.reached ? DOT[rung.tone] : 'bg-[#374151]'],
                    ]}
                  />
                </span>
                <span
                  class:list={[
                    'mt-[3px] text-[7px] font-bold leading-[9px]',
                    isNext ? 'text-[#1FD9FF]' : rung.reached ? 'text-[#6b7280]' : 'text-[#4b5563]',
                  ]}
                >
                  {rung.day}
                </span>
              </span>
            </>
          );
        })
      }
    </div>

    <div class="mt-[8px] border-t border-[#374151]/30 pt-[7px]">
      {
        NEXT.map((node, i) => (
          <div class:list={['flex items-center', i < NEXT.length - 1 && 'mb-[4px]']}>
            {/* The icon the path draws for that kind, in the greys it uses for
                what is still ahead: the card is a window onto that screen, so a
                heart here has to be the heart there. */}
            <span class="flex w-[10px] shrink-0 justify-start" aria-hidden="true">
              {node.kind === 'health' ? (
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke={i === 0 ? '#9ca3af' : '#6b7280'} stroke-width="2">
                  <path d="M12 20.3 3.6 12a5 5 0 0 1 8.4-5.2A5 5 0 0 1 20.4 12l-8.4 8.3Z" stroke-linejoin="round" />
                </svg>
              ) : node.kind === 'symptom' ? (
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke={i === 0 ? '#9ca3af' : '#6b7280'} stroke-width="2">
                  <path d="M3 7.5 9.5 14l4-4 4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M21 10.5v5h-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke={i === 0 ? '#9ca3af' : '#6b7280'} stroke-width="2">
                  <path d="M7 4h10v5a5 5 0 0 1-10 0V4Z" stroke-linejoin="round" />
                  <path d="M7 5.5H4V7a3 3 0 0 0 3 3m10-4.5h3V7a3 3 0 0 1-3 3M12 14v4m-3.5 2h7" stroke-linecap="round" />
                </svg>
              )}
            </span>
            {/* The nearest one carries the accent and the ones behind it recede.
                A list where every line shouts equally is one nobody reads. */}
            <span
              class:list={[
                'mx-[5px] flex-1 truncate text-[8px] leading-[10px]',
                i === 0 ? 'text-[#e5e7eb]' : 'text-[#9ca3af]',
              ]}
            >
              {node.label}
            </span>
            <span
              class:list={[
                'shrink-0 text-[8px] font-medium leading-[10px]',
                i === 0 ? 'text-[#1FD9FF]' : 'text-[#6b7280]',
              ]}
            >
              {inDays(node.inDays)}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  {/*
    The milestone push, the same device the press screen uses for a friend's
    pouch. Here it is the app's own, so the sender is Breezer and the icon is
    the app's.

    It is about the node the strip below is walking towards, which is why it
    names the same thing the first row of that list does: a banner and a list
    that disagree about what is coming next read as two mockups rather than as
    one screen. `lib/quitNotifications.js` does schedule a push per journey node,
    but for a symptom day its `titleFor` falls through to the generic
    `journey.title`, which says nothing about what is easing. So this is phrased
    from `journey.symptomEased` and the one day still to go instead.

    The name carries the title and the rest goes in the body, because a
    notification title is one line: the whole sentence would be cut after
    "Stimmungsschwankungen fast übe…" at this width.

    Inside the screen so it scales with it and clips at the window edge, the way
    the OS draws it over the app. aria-hidden because it is a picture of a
    notification: the same claim is made in real copy further down the page.

    top-[26px] rather than the 8px the press screen's banner started at:
    `mobile-frame.png` draws the notch into the screen window (x 76..185,
    y 0..21 of the 261x566 box), so a banner any higher slides under it and the
    frame paints the island over its first line. A short sender name happens to
    sit clear of it; a title that runs the full width does not. 26px is the
    status bar's own height, so the banner starts exactly where that ends, which
    is where iOS puts it.
  */}
  <div
    class="quit-phone__banner pointer-events-none absolute inset-x-[8px] top-[26px]"
    data-quit-banner
    aria-hidden="true"
  >
    <div
      class="flex items-start gap-[7px] rounded-[16px] bg-[#1c1c1e]/85 p-[8px] shadow-lg backdrop-blur-md"
    >
      <Image
        src={appIcon}
        width={44}
        height={44}
        alt=""
        aria-hidden="true"
        class="h-[26px] w-[26px] shrink-0 rounded-[7px]"
        loading="lazy"
        decoding="async"
      />
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline justify-between gap-[6px]">
          <span class="truncate text-[10px] font-semibold leading-[13px] text-white"
            >{t.app_quit_notif_title}</span
          >
          <span class="shrink-0 text-[8px] leading-[13px] text-[#9ca3af]">{t.app_notif_ago}</span>
        </div>
        <p class="text-[10px] leading-[13px] text-white/90">{t.app_quit_notif_body}</p>
      </div>
    </div>
  </div>
</AppScreen>

<style>
  /* Hidden until `quit-phone.js` shows it, so it never flashes on first paint.
     Same treatment as the press screen's banner, because it is the same object
     arriving the same way. */
  .quit-phone__banner {
    opacity: 0;
    transform: translateY(-120%);
  }
  .quit-phone__banner[data-visible] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .quit-phone__banner {
      transition:
        opacity 320ms ease,
        transform 380ms cubic-bezier(0.16, 0.84, 0.44, 1);
    }
  }
</style>
