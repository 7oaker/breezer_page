---
/**
 * The app's quit-mode home screen, rebuilt as real DOM so the clock actually
 * runs.
 *
 * This replaced a flat screenshot. The screen's whole point is that a number is
 * moving in your favour every second you do not take a pouch, and a still
 * freezes exactly the thing that makes it work. Nothing here is operable — the
 * visitor watches it — but the seconds tick, the minutes roll over, and
 * avoided / saved / gained climb with them, which is what
 * `react_Breezer/components/homecards/QuittingView.jsx` does with a single
 * one-second interval that recomputes the whole screen from the elapsed
 * duration.
 *
 * The arithmetic is that file's `computeQuittingSavings` verbatim
 * (`utility/helperFunctions.js:46-80`) at the app's defaults. Geometry follows
 * AppScreen's contract; landmarks were measured off
 * `screens/new/quitting-home.png`.
 *
 * NAMES. The source screenshot shows real Breezer users on the leaderboard and
 * a real account name in the congratulations line. Publishing those would put
 * real people on a public marketing page without their consent, so every name
 * here is invented. The day counts and the avatar colours are the screenshot's.
 */
import { Image } from 'astro:assets';
import AppScreen from './AppScreen.astro';
import type { UI } from '../../i18n/ui';
import { fill } from '../../i18n/ui';
import quitBg from '../../assets/images/app/quit-bg.jpg';
import pouch from '../../assets/images/app/logo-small.png';

interface Props {
  t: UI;
  class?: string;
}
const { t, class: className = '' } = Astro.props;

/**
 * How long the sample account has been snus free. Anchored relative to page
 * load rather than to a date baked into the HTML — a fixed start date would
 * read "24 Days" today and "300 Days" after a few months without a rebuild.
 *
 * Under a month on purpose: the YEAR and MONTH chips both read zero, so the
 * hours and minutes are what the eye lands on and the clock is visibly doing
 * something. The screenshot's 143 days pushed the interesting digits into
 * MONTH, where nothing moves while anyone is watching.
 */
const QUIT_SECONDS = 24 * 86400 + 7 * 3600 + 12 * 60 + 40;

/** The app's habit defaults, which are what the screenshot's numbers imply. */
const HABIT = { dailyLimit: 10, pricePerPack: 6, snusPerPack: 24, minutesPerSnus: 30 };

/** `computeQuittingSavings`, verbatim. Duplicated in quit-phone.js for ticking. */
function savingsFor(elapsedSeconds: number) {
  const days = elapsedSeconds / 86400;
  const expected = Math.max(0, days * HABIT.dailyLimit);
  const costPerSnus = HABIT.pricePerPack / HABIT.snusPerPack;
  return {
    avoided: Math.floor(expected),
    saved: expected * costPerSnus,
    minutesGained: Math.round(expected * HABIT.minutesPerSnus),
  };
}

/** The app: `Nd Nh` once a day has accrued, else `Nh Nm`. */
function formatGained(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const days = Math.floor(hours / 24);
  return days > 0 ? `${days}d ${hours % 24}h` : `${hours}h ${minutes % 60}m`;
}

const seedSavings = savingsFor(QUIT_SECONDS);
const totalDays = Math.floor(QUIT_SECONDS / 86400);

/**
 * The six chips are a calendar decomposition of the same span the big number
 * floors, which is why `0y 4m 21d` and `143 Days` sit on the same card without
 * contradicting each other.
 */
function decompose(from: Date, to: Date) {
  let years = to.getFullYear() - from.getFullYear();
  let months = to.getMonth() - from.getMonth();
  let days = to.getDate() - from.getDate();
  let hours = to.getHours() - from.getHours();
  let minutes = to.getMinutes() - from.getMinutes();
  let seconds = to.getSeconds() - from.getSeconds();
  if (seconds < 0) (seconds += 60), (minutes -= 1);
  if (minutes < 0) (minutes += 60), (hours -= 1);
  if (hours < 0) (hours += 24), (days -= 1);
  if (days < 0) {
    days += new Date(to.getFullYear(), to.getMonth(), 0).getDate();
    months -= 1;
  }
  if (months < 0) (months += 12), (years -= 1);
  return { years, months, days, hours, minutes, seconds };
}

const buildNow = new Date();
const seedChips = decompose(new Date(buildNow.getTime() - QUIT_SECONDS * 1000), buildNow);

/**
 * The app's milestone lists evaluated at the seed above. Constants rather than
 * a live computation because neither can change inside a visit: health is
 * `[1,3,7,14,30,90,180,365,1825]` filtered by days elapsed, so 24 days clears
 * the first four. Achievements is a 24-target list over days, pouches, packs,
 * money and hours gained; at 243 pouches, 60.75 € and 121 hours everything is
 * met except the 30/90/180/365-day marks, 500 pouches and 100/250 €.
 */
const HEALTH_DONE = 4;
const HEALTH_TOTAL = 9;
const ACHIEVEMENTS_DONE = 17;
const ACHIEVEMENTS_TOTAL = 24;

/** Invented names; day counts and avatar colours are the screenshot's. */
const RANKING = [
  { initials: 'JL', name: 'Jonas Lindqvist', days: 286, bg: '#85DBD8' },
  { initials: 'TK', name: 'Tobias Krause', days: 283, flag: '🇩🇪', bg: '#85DBD8' },
  { initials: 'EM', name: 'Elena Moreno', days: 267, flag: '🇪🇸', bg: '#7C67FE' },
];

const CHIPS = [
  { value: seedChips.years, label: t.app_quit_label_year, key: 'years' },
  { value: seedChips.months, label: t.app_quit_label_month, key: 'months' },
  { value: seedChips.days, label: t.app_quit_label_day, key: 'days' },
  { value: seedChips.hours, label: t.app_quit_label_hour, key: 'hours' },
  { value: seedChips.minutes, label: t.app_quit_label_min, key: 'minutes' },
  { value: seedChips.seconds, label: t.app_quit_label_sec, key: 'seconds' },
];

const CONFIG = { quitSeconds: QUIT_SECONDS, habit: HABIT };
---

<AppScreen class={className} data-quit-phone data-config={JSON.stringify(CONFIG)}>
  <p class="sr-only">{t.app_quit_demo_caption}</p>

  {/* Status bar */}
  <div
    class="flex h-[26px] shrink-0 items-start justify-between px-[14px] pt-[13px] text-[10px] font-semibold leading-[11px] text-white"
    aria-hidden="true"
  >
    <span>07:04</span>
    <span class="flex items-center gap-[3px]">
      <svg width="14" height="9" viewBox="0 0 14 9" fill="currentColor"
        ><rect x="0" y="6" width="2.4" height="3" rx=".6"></rect><rect
          x="3.6"
          y="4"
          width="2.4"
          height="5"
          rx=".6"></rect><rect x="7.2" y="2" width="2.4" height="7" rx=".6"></rect><rect
          x="10.8"
          y="0"
          width="2.4"
          height="9"
          rx=".6"></rect></svg
      >
      <svg width="12" height="9" viewBox="0 0 16 12" fill="none" stroke="currentColor"
        ><path d="M1 4a10 10 0 0 1 14 0" stroke-width="1.6" stroke-linecap="round"></path><path
          d="M4 7a6 6 0 0 1 8 0"
          stroke-width="1.6"
          stroke-linecap="round"></path><circle cx="8" cy="10.2" r="1.1" fill="currentColor"
          stroke="none"></circle></svg
      >
      <span class="rounded-[3px] border border-white/50 px-[3px] text-[8px] font-bold leading-[10px]"
        >100</span
      >
    </span>
  </div>

  {/* Top bar. Streak 1, so the flame is still the accent cyan. */}
  <div class="mt-[19px] flex h-[20px] shrink-0 items-center justify-between px-[12px]">
    <div class="flex items-center gap-[6px]">
      <span class="text-[16px] font-bold leading-none text-white">1</span>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="#1FD9FF" aria-hidden="true"
        ><path
          d="M12 2c.5 3.2-1.4 4.6-2.8 6C7.6 9.6 6 11.2 6 14a6 6 0 0 0 12 0c0-3-1.6-4.8-3-6.4-.8.9-1.6 1.3-2.3 1-.9-.4-1.1-1.7-.4-3.4C12.7 4 12.6 2.9 12 2Zm0 11.2c1.3 1 1.9 1.9 1.9 2.9a1.9 1.9 0 0 1-3.8 0c0-1 .6-1.9 1.9-2.9Z"
        ></path></svg
      >
    </div>
    <div class="flex items-center gap-[13px] text-[#9ca3af]" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M12 3v12M12 3 8 7M12 3l4 4" stroke-linecap="round" stroke-linejoin="round"
        ></path><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" stroke-linecap="round"></path></svg
      >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 1.8c-3.6 0-8 1.8-8 4.6V21h16v-2.6c0-2.8-4.4-4.6-8-4.6Z"
        ></path></svg
      >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="m19.4 13-.1-1 2-1.6-2-3.4-2.4.9c-.5-.4-1.1-.7-1.7-1L14.8 4h-4l-.4 2.9c-.6.3-1.2.6-1.7 1l-2.4-.9-2 3.4 2 1.6a7.6 7.6 0 0 0 0 2l-2 1.6 2 3.4 2.4-.9c.5.4 1.1.7 1.7 1l.4 2.9h4l.4-2.9c.6-.3 1.2-.6 1.7-1l2.4.9 2-3.4-2-1.6.1-1Zm-6.6 3.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Z"
        ></path></svg
      >
    </div>
  </div>

  <p class="mt-[14px] shrink-0 text-center text-[16px] font-bold leading-[20px] text-white">
    {fill(t.app_quit_congrats, { name: 'Klaus' })}
  </p>

  {/*
    Hero card over the app's own photo. No scrim: the app has none either, and
    the only darkening is the chips' and tiles' own translucent fill.
  */}
  <div class="relative mx-[11px] mt-[7px] h-[176px] shrink-0 overflow-hidden rounded-[8px]">
    <Image
      src={quitBg}
      width={480}
      height={312}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="relative flex h-full flex-col p-[8px]">
      <p class="text-center text-[9px] font-extrabold leading-[11px] text-white">
        {t.app_quit_snus_free_for}
      </p>
      <p class="mt-[2px] text-center text-[32px] font-extrabold leading-[38px] text-white"
        ><span data-quit-total-days>{totalDays}</span> {t.app_quit_days}</p
      >

      <div class="mt-[6px] flex justify-between">
        {
          CHIPS.map((chip) => (
            <span class="flex w-[16%] flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[5px]">
              <span
                class="text-[9px] font-bold leading-[11px] text-white"
                data-quit-chip={chip.key}
              >
                {chip.value}
              </span>
              <span class="text-[6px] leading-[8px] text-[#d1d5db]">{chip.label}</span>
            </span>
          ))
        }
      </div>

      <div class="mt-auto flex gap-[3px]">
        <span class="flex flex-1 flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[6px]">
          <span class="flex items-center gap-[3px] text-[13px] font-bold leading-[15px] text-white">
            <span data-quit-avoided>{seedSavings.avoided}</span>
            <Image
              src={pouch}
              width={26}
              height={26}
              alt=""
              aria-hidden="true"
              class="h-[13px] w-[13px]"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="mt-[2px] text-[8px] leading-[10px] text-[#d1d5db]">{t.app_quit_avoided}</span>
        </span>
        <span class="flex flex-1 flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[6px]">
          <span class="text-[13px] font-bold leading-[15px] text-white" data-quit-saved
            >{seedSavings.saved.toFixed(1)} €</span
          >
          <span class="mt-[2px] text-[8px] leading-[10px] text-[#d1d5db]">{t.app_quit_saved}</span>
        </span>
        <span class="flex flex-1 flex-col items-center rounded-[8px] bg-[#1f2937]/50 py-[6px]">
          <span class="text-[13px] font-bold leading-[15px] text-white" data-quit-gained
            >{formatGained(seedSavings.minutesGained)}</span
          >
          <span class="mt-[2px] text-[8px] leading-[10px] text-[#d1d5db]">{t.app_quit_gained}</span>
        </span>
      </div>
    </div>
  </div>

  {/* Health and Achievements */}
  <div class="mx-[8px] mt-[18px] flex h-[78px] shrink-0 gap-[6px]">
    <div class="flex w-1/2 flex-col rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] p-[8px]">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold leading-none text-white">{t.app_quit_health}</span>
        <span class="rounded-[5px] bg-[#ef4444]/15 p-[4px]" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="#6b7280"
            ><path
              d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.6 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9Z"
            ></path></svg
          >
        </span>
      </div>
      <p class="mt-[6px] flex items-baseline">
        <span class="text-[12px] font-bold leading-none text-white">{HEALTH_DONE}</span>
        <span class="text-[8px] leading-none text-[#6b7280]">/{HEALTH_TOTAL}</span>
        <span class="ml-[4px] text-[8px] leading-none text-[#9ca3af]">{t.app_quit_completed}</span>
      </p>
      <span class="mt-auto flex items-center gap-[2px] text-[8px] font-medium leading-none text-[#1FD9FF]">
        {t.app_quit_view}
        <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"
          ><path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </span>
    </div>

    <div class="flex w-1/2 flex-col rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] p-[8px]">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-bold leading-none text-white">{t.app_quit_achievements}</span>
        <span class="rounded-[5px] bg-[#facc15]/15 p-[4px]" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="#6b7280"
            ><path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2Zm-3 11-2 9 5-3 5 3-2-9a7 7 0 0 1-6 0Z"
            ></path></svg
          >
        </span>
      </div>
      <p class="mt-[6px] flex items-baseline">
        <span class="text-[12px] font-bold leading-none text-white">{ACHIEVEMENTS_DONE}</span>
        <span class="text-[8px] leading-none text-[#6b7280]">/{ACHIEVEMENTS_TOTAL}</span>
        <span class="ml-[4px] text-[8px] leading-none text-[#9ca3af]">{t.app_quit_unlocked}</span>
      </p>
      <span class="mt-auto flex items-center gap-[2px] text-[8px] font-medium leading-none text-[#1FD9FF]">
        {t.app_quit_view}
        <svg width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"
          ><path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </span>
    </div>
  </div>

  {/* Share pill */}
  <div
    class="mx-[8px] mt-[12px] flex h-[28px] shrink-0 items-center justify-center gap-[5px] rounded-[11px] bg-gradient-to-r from-[#1E1E2D] to-[#232533]"
  >
    <span class="text-[9px] font-medium leading-none text-[#d1d5db]">{t.app_share_with_friend}</span>
    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="2" aria-hidden="true"
      ><path d="M12 3v12M12 3 8 7M12 3l4 4" stroke-linecap="round" stroke-linejoin="round"
      ></path><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" stroke-linecap="round"></path></svg
    >
  </div>

  {/* Quitters Ranking. Static: the app computes these counts once, server-side,
      so they do not tick either. */}
  <div
    class="mx-[8px] mt-[4px] shrink-0 rounded-[11px] bg-gradient-to-br from-[#1E1E2D] to-[#232533] p-[8px]"
  >
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-bold leading-none text-white">{t.app_quit_ranking}</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="#1FD9FF" aria-hidden="true"
        ><path
          d="M6 3h12v5a6 6 0 0 1-5 5.9V17h3v2H8v-2h3v-3.1A6 6 0 0 1 6 8V3Zm-4 1h3v3a3 3 0 0 1-3-3Zm17 0h3a3 3 0 0 1-3 3V4ZM7 20h10v2H7v-2Z"
        ></path></svg
      >
    </div>
    {
      RANKING.map((row, i) => (
        <div class="mt-[7px] flex items-center">
          <span class="w-[13px] shrink-0 text-[9px] font-bold leading-none text-[#6b7280]">
            {i + 1}.
          </span>
          <span
            class="mx-[5px] flex h-[19px] w-[19px] shrink-0 items-center justify-center rounded-full text-[8px] font-bold leading-none ring-1 ring-[#1FD9FF]/30"
            style={`background-color: ${row.bg}; color: #1F1F2E`}
            aria-hidden="true"
          >
            {row.initials}
          </span>
          <span class="flex-1 truncate text-[9px] leading-[11px] text-[#e5e7eb]">
            {row.name}
            {row.flag ? ` ${row.flag}` : ''}
          </span>
          <span class="shrink-0 text-[8px] font-bold leading-none text-[#1FD9FF]">
            {row.days} {t.app_quit_days}
          </span>
        </div>
      ))
    }
    <p
      class="mt-[6px] border-t border-[#374151]/30 pt-[6px] text-center text-[8px] font-medium leading-none text-[#1FD9FF]"
    >
      {t.app_quit_leaderboard}
    </p>
  </div>
</AppScreen>
