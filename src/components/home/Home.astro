              </div>

              <div class="w-full px-4 md:w-1/2 lg:w-1/3">
                <div
                  class="wow fadeInUp group mx-auto mb-[30px] max-w-[310px] text-center"
                  data-wow-delay=".4s"
                >
                  <div
