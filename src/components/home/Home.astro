---
import { Image } from 'astro:assets';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import Icon from '../Icon.astro';
import type { UI } from '../../i18n/ui';
import img_author_04 from '../../assets/images/testimonials/author-04.png';
import img_author_1 from '../../assets/images/testimonials/author-1.png';
import img_author_2 from '../../assets/images/testimonials/author-2.png';
import img_author_3 from '../../assets/images/testimonials/author-3.png';
import img_hero_light from '../../assets/images/hero/hero-light.png';
import img_mobile_frame from '../../assets/images/screens/mobile-frame.png';
import img_notification from '../../assets/images/screens/new/notification.png';
import img_quitting_achievements from '../../assets/images/screens/new/quitting-achievements.png';
import img_quitting_health from '../../assets/images/screens/new/quitting-health.png';
import img_quitting_home from '../../assets/images/screens/new/quitting-home.png';
import img_quitting_social from '../../assets/images/screens/new/quitting-social.png';
import img_snus_activities from '../../assets/images/screens/new/snus-activities.png';
import img_snus_chat from '../../assets/images/screens/new/snus-chat.png';
import img_snus_feed from '../../assets/images/screens/new/snus-feed.png';
import img_snus_profile from '../../assets/images/screens/new/snus-profile.png';
import img_snus_promotions from '../../assets/images/screens/new/snus-promotions.png';
import img_snus_ranking from '../../assets/images/screens/new/snus-ranking.png';
import img_snus_stats from '../../assets/images/screens/new/snus-stats.png';
import img_take_snus from '../../assets/images/screens/new/take-snus.png';
import img_widget_quit_1 from '../../assets/images/screens/widget/widget_quit_1.jpg';
import img_widget_quit_2 from '../../assets/images/screens/widget/widget_quit_2.jpg';
import img_widget_track_1 from '../../assets/images/screens/widget/widget_track_1.jpg';
import img_widget_track_2 from '../../assets/images/screens/widget/widget_track_2.jpg';

interface Props {
  t: UI;
  lang: 'en' | 'de';
}
const { t, lang } = Astro.props;
const home = lang === 'de' ? '/de/' : '/';
---
<main>
      
      <section id="home" class="pt-[165px]">
        <div class="container lg:max-w-[1305px] lg:px-10">
          <div class="-mx-4 flex flex-wrap items-center">
            <div class="w-full px-4 lg:w-7/12">
              <div
                class="wow fadeInUp mb-12 lg:mb-0 lg:max-w-[570px]"
                data-wow-delay=".2s"
              >
                <span
                  class="mb-5 block text-lg font-medium leading-tight text-black dark:text-white sm:text-[22px] xl:text-[22px]"
                >
                {t.ready_to_track_snus_with_friends}

                </span>
                <h1
                  class="mb-6 text-3xl font-bold leading-tight text-black dark:text-white sm:text-[40px] md:text-[50px] lg:text-[42px] xl:text-[50px]"
                >
                  {t.the_social}
                  <span
                    class="inline bg-gradient-1 bg-clip-text text-transparent"
                  >
                    {t.snus_app}
                  </span>
                  {t.for_tracking_ranking_and_quitting}
                </h1>
                <p
                  class="mb-10 max-w-[475px] text-base leading-relaxed text-body"
                >
                  {t.log_every_pouch_with_one_tap}
                </p>

                <div class="flex flex-wrap items-center gap-4">
                  <div class="inline-block">
                    <a
                      href="https://play.google.com/store/apps/details?id=com.breezerapp.breezer"
                      class="inline-flex items-center rounded-md bg-primary py-[10px] pl-4 pr-5 text-white hover:bg-opacity-90"
                    >
                      <span class="mr-[10px]">
                        <svg
                          width="34"
                          height="34"
                          viewBox="0 0 34 34"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M4 28.9958V4.9125C4 4.07667 4.48167 3.34 5.19 3L19.1442 16.9542L5.19 30.9083C4.48167 30.5542 4 29.8317 4 28.9958ZM23.5642 21.3742L8.32083 30.1858L20.3483 18.1583L23.5642 21.3742ZM28.31 15.2683C28.7917 15.6508 29.1458 16.2458 29.1458 16.9542C29.1458 17.6625 28.8342 18.2292 28.3383 18.6258L25.0942 20.4958L21.5525 16.9542L25.0942 13.4125L28.31 15.2683ZM8.32083 3.7225L23.5642 12.5342L20.3483 15.75L8.32083 3.7225Z"
                            fill="currentColor"
                          />
                        </svg>
                      </span>
                      <span class="text-left">
                        <span class="block text-xs opacity-70">
                          {t.get_it_on}
                        </span>
                        <span class="block text-sm font-medium">
                          {t.google_play}
                        </span>
                      </span>
                    </a>
                  </div>
      
                  <div class="inline-block">
                    <a
                      href="https://apps.apple.com/at/app/breezer/id6737725511?l=en-GB"
                      class="inline-flex items-center rounded-md bg-black py-[10px] pl-4 pr-5 text-white hover:bg-opacity-90 dark:bg-white dark:text-black dark:hover:bg-opacity-90"
                    >
                      <span class="mr-[10px]">
                        <svg
                          width="34"
                          height="34"
                          viewBox="0 0 34 34"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M26.5058 27.625C25.33 29.3817 24.0833 31.0959 22.185 31.1242C20.2867 31.1667 19.6775 30.005 17.5242 30.005C15.3567 30.005 14.6908 31.0959 12.8917 31.1667C11.0358 31.2375 9.63333 29.2967 8.44333 27.5825C6.02083 24.0834 4.165 17.6375 6.65833 13.3025C7.89083 11.1492 10.1008 9.78921 12.495 9.74671C14.3083 9.71837 16.0367 10.9792 17.1558 10.9792C18.2608 10.9792 20.3575 9.46337 22.5533 9.69004C23.4742 9.73254 26.0525 10.0584 27.71 12.495C27.5825 12.58 24.6358 14.3084 24.6642 17.8925C24.7067 22.1709 28.4183 23.6017 28.4608 23.6159C28.4183 23.715 27.8658 25.6559 26.5058 27.625ZM18.4167 4.95837C19.4508 3.78254 21.165 2.89004 22.5817 2.83337C22.7658 4.49087 22.1 6.16254 21.1083 7.35254C20.1308 8.55671 18.5158 9.49171 16.9292 9.36421C16.7167 7.73504 17.51 6.03504 18.4167 4.95837Z"
                            fill="currentColor"
                          />
                        </svg>
                      </span>
                      <span class="text-left">
                        <span class="block text-xs opacity-70">
                          {t.download_from}
                        </span>
                        <span class="block text-sm font-medium">
                          {t.app_store}
                        </span>
                      </span>
                    </a>
                  </div>

                </div>
              </div>
            </div>

            <div class="w-full px-4 lg:w-5/12">
              <div
                class="wow fadeInUp relative z-10 mx-auto w-full max-w-[530px] pt-8 lg:mr-0"
                data-wow-delay=".3s"
              >
                <Image src={img_hero_light} width={376} height={546}
                  alt={t.breezer_app_press_snus}
                  class="mx-auto max-w-full"
                  fetchpriority="high"
                  loading="eager"
                  decoding="sync" />
                <div
                  class="max-auto absolute top-0 left-0 right-0 pointer-events-none -z-10 aspect-square w-full rounded-full bg-gradient-1"
                >
                  <div class="absolute top-5 right-0">
                    <svg
                      width="72"
                      height="51"
                      viewBox="0 0 72 51"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <g clip-path="url(#clip0_5_3665)">
                        <path
