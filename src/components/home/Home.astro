                    {t.start_tracking_and_ranking_together}
                  </p>
                </div>
              </div>
            </div>
          </div>
      </div>

        <div
          class="absolute -top-28 left-0 pointer-events-none -z-10 hidden md:block"
        >
          <svg
            width="632"
            height="1179"
            viewBox="0 0 632 1179"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g opacity="0.25" filter="url(#filter0_f_38_24)">
              <circle
