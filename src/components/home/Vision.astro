---
/**
 * Why the app exists, immediately before the screenshots.
 *
 * The page up to here is argument — features, numbers, devices — and the page
 * after it is proof. This is the one place that says what the thing is for, so
 * it is deliberately the quietest section on the homepage: no gradient, no icon
 * set, one portrait and the sentence. Everything around it is already loud, and
 * a statement of intent that arrives dressed as an ad reads as an ad.
 *
 * Spoken, and marked up as spoken: a `blockquote`, because the statement is the
 * founder's own rather than the site's. The eyebrow above it says whose, which
 * is why there is no signature under it: one section this short does not need
 * the word "founder" twice.
 *
 * The portrait is `FounderPortrait.astro`, shared with the Pro page's founder
 * note: a line drawing rather than a photograph, for the reason given in
 * `src/data/authors.ts`.
 */
import FounderPortrait from '../FounderPortrait.astro';
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI;
}
const { t } = Astro.props;
---

<section id="vision" class="relative z-20 pt-[110px]">
  <div class="container">
    <figure class="mx-auto max-w-[760px] border-t border-stroke pt-14 text-center dark:border-stroke-dark">
      <p class="text-sm font-medium text-primary dark:text-primary-light">{t.vision_eyebrow}</p>

      <FounderPortrait class="mx-auto mt-6" />

      <blockquote
        class="wow fadeInUp mt-8"
        data-wow-delay=".2s"
      >
        {/* No `ch` cap on this one: the line is short enough to sit on one at
            every width the container allows, and a cap sized for a longer
            sentence would break it in half for no reason. */}
        <p class="text-3xl font-bold leading-tight text-black dark:text-white sm:text-4xl md:text-[44px] md:leading-tight">
          {t.vision_heading}
        </p>
        <p class="mx-auto mt-6 max-w-[62ch] text-base leading-relaxed text-body sm:text-lg">
          {t.vision_body}
        </p>
      </blockquote>
    </figure>
  </div>
</section>
