---
import { footerNav, navFor, route, routes, type Lang } from '../i18n/routes';
import { locales, localeCodes } from '../i18n/locales';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

// Legal links are noindex pages but must stay reachable — app stores and the
// Austrian ECG/MedienG disclosure rules both expect them in the footer.
/**
 * Labelled in the reader's language even where the target page is not
 * translated. The label says what the page is; the language it happens to be
 * in is a separate fact, and an English label in a Swedish footer just reads
 * as an oversight.
 */
const t = {
  en: { privacySite: 'Privacy Policy Website', privacyApp: 'Privacy Policy App', terms: 'Terms and conditions', imprint: 'Imprint', cookies: 'Cookie settings', guides: 'Snus App Guides', legal: 'Legal' },
  de: { privacySite: 'Datenschutz Website', privacyApp: 'Datenschutz App', terms: 'AGB', imprint: 'Impressum', cookies: 'Cookie-Einstellungen', guides: 'Snus App Guides', legal: 'Rechtliches' },
  sv: { privacySite: 'Integritetspolicy webbplats', privacyApp: 'Integritetspolicy app', terms: 'Villkor', imprint: 'Imprint', cookies: 'Cookieinställningar', guides: 'Guider', legal: 'Juridik' },
}[lang];

const legal = [
  { href: '/privacy-policy-website', label: t.privacySite },
  { href: '/privacy-policy', label: t.privacyApp },
  { href: '/eula', label: t.terms },
  { href: route('imprint', lang), label: t.imprint },
];
---

<footer>
  <div class="bg-primary py-7 dark:bg-black">
    <div class="container max-w-[1390px]">
      <div class="-mx-3 flex flex-wrap items-center gap-y-4">
        <div class="w-full px-3 lg:w-1/3">
          <p class="text-center text-sm text-white lg:text-left">
            &#169; {new Date().getFullYear()} Breezer. Made in Austria.
          </p>
        </div>
        <div class="w-full px-3 lg:w-1/3">
          <nav
            aria-label={t.guides}
            class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-white"
          >
            {navFor(footerNav, lang).map((item) => (
              <a href={route(item.key, lang)} class="hover:opacity-80">{item.label[lang]}</a>
            ))}
          </nav>
        </div>
        <div class="w-full px-3 lg:w-1/3">
          <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-white lg:justify-end">
            {/*
              One link per other language, named in that language. The old
              version offered exactly one alternative, which on a third locale
              meant Swedish readers were offered German and nothing else.
            */}
            {localeCodes
              .filter((code) => code !== lang)
              .map((code) => (
                <a
                  href={routes.home[code] ?? '/'}
                  hreflang={locales[code].hreflang[0]}
                  data-set-lang={code}
                  class="hover:opacity-80"
                >{locales[code].name}</a>
              ))}
            <a href="javascript:void(0)" data-cookie-settings class="hover:opacity-80">
              {t.cookies}
            </a>
          </div>
        </div>
      </div>

      <div class="mt-4 border-t border-white/20 pt-4">
        <nav
          aria-label={t.legal}
          class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-white/80"
        >
          {legal.map((item) => <a href={item.href} class="hover:text-white">{item.label}</a>)}
        </nav>
      </div>
    </div>
  </div>
</footer>

<a
      href="javascript:void(0)"
      class="back-to-top fixed bottom-8 right-8 left-auto z-[999] hidden h-10 w-10 items-center justify-center rounded-md bg-primary text-white shadow-md duration-300 ease-in-out hover:bg-opacity-80"
    >
      <span
        class="mt-[6px] h-3 w-3 rotate-45 border-t border-l border-white"
      ></span>
    </a>

