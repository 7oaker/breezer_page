---
import { footerNav, navFor, route, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';

// Legal links are noindex pages but must stay reachable — app stores and the
// Austrian ECG/MedienG disclosure rules both expect them in the footer.
const legal = [
  { href: '/privacy-policy-website', label: de ? 'Datenschutz Website' : 'Privacy Policy Website' },
  { href: '/privacy-policy', label: de ? 'Datenschutz App' : 'Privacy Policy App' },
  { href: '/eula', label: de ? 'AGB' : 'Terms and conditions' },
  { href: route('imprint', lang), label: de ? 'Impressum' : 'Imprint' },
];
---

<footer>
  <div class="bg-primary py-7 dark:bg-black">
    <div class="container max-w-[1390px]">
      <div class="-mx-3 flex flex-wrap items-center gap-y-4">
        <div class="w-full px-3 lg:w-1/3">
          <p class="text-center text-sm text-white lg:text-left">
            &#169; {new Date().getFullYear()} Breezer. {de ? 'Made in Austria.' : 'Made in Austria.'}
          </p>
        </div>
        <div class="w-full px-3 lg:w-1/3">
          <nav
            aria-label={de ? 'Snus App Guides' : 'Snus App Guides'}
            class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-white"
          >
            {navFor(footerNav, lang).map((item) => (
              <a href={route(item.key, lang)} class="hover:opacity-80">{item.label[lang]}</a>
            ))}
          </nav>
        </div>
        <div class="w-full px-3 lg:w-1/3">
          <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-white lg:justify-end">
            {de
              ? <a href="/" data-set-lang="en" class="hover:opacity-80">English</a>
              : <a href="/de" data-set-lang="de" class="hover:opacity-80">Deutsch</a>}
            <a href="javascript:void(0)" data-cookie-settings class="hover:opacity-80">
              {de ? 'Cookie-Einstellungen' : 'Cookie settings'}
            </a>
          </div>
        </div>
      </div>

      <div class="mt-4 border-t border-white/20 pt-4">
        <nav
          aria-label={de ? 'Rechtliches' : 'Legal'}
          class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs text-white/80"
        >
          {legal.map((item) => <a href={item.href} class="hover:text-white">{item.label}</a>)}
        </nav>
      </div>
    </div>
  </div>
</footer>

<a
      href="javascript:void(0)"
      class="back-to-top fixed bottom-8 right-8 left-auto z-[999] hidden h-10 w-10 items-center justify-center rounded-md bg-primary text-white shadow-md duration-300 ease-in-out hover:bg-opacity-80"
    >
      <span
        class="mt-[6px] h-3 w-3 rotate-45 border-t border-l border-white"
      ></span>
    </a>

