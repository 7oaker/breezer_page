---
/**
 * A framed app screenshot with the homepage's gradient glow behind it.
 * The frame geometry itself lives in PhoneFrame.
 */
import type { ImageMetadata } from 'astro';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Above-the-fold shots should not be lazy-loaded. */
  eager?: boolean;
  class?: string;
}
const { src, alt, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['relative mx-auto w-full max-w-[295px]', className]}>
  <PhoneFrame src={src} alt={alt} eager={eager} />
  <div
    class="absolute -inset-x-6 top-10 bottom-10 -z-10 rounded-[40px] bg-gradient-1 opacity-[0.07] blur-2xl"
    aria-hidden="true"
  >
  </div>
</figure>
