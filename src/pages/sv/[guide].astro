---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { guideSets, setFor } from '../../i18n/translations';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.lang === 'sv' && !g.data.draft);
  return guides.map((entry) => ({ params: { guide: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const alternates = setFor(await guideSets(), d.translationKey);
---

<Article
  lang="sv"
  title={d.title}
  heading={d.heading}
  description={d.description}
  summary={d.summary}
  path={`/sv/${d.slug}`}
  alternates={alternates}
  crumbs={[
    { name: 'Snus App', path: '/sv' },
    { name: d.heading, path: `/sv/${d.slug}` },
  ]}
  publishDate={d.publishDate}
  updatedDate={d.updatedDate}
  faq={d.faq}
  heroImage={d.heroImage}
  heroImageAlt={d.heroImageAlt}
  gallery={d.gallery}
>
  <Content />
</Article>
