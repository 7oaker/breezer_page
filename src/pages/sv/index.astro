---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Home from '../../components/home/Home.astro';
import { useTranslations } from '../../i18n/ui';
import { homeFaq } from '../../i18n/faq';
import { website, organization, mobileApp, faqPage } from '../../i18n/schema';
import { routes } from '../../i18n/routes';

const lang = 'sv' as const;
const t = useTranslations(lang);
---

<Base
  lang={lang}
  title="Breezer: social snusapp – tracka, ranka och sluta"
  description="Breezer är den sociala snusappen: tracka din konsumtion, tävla med vänner och sluta snusa med Quit-läget. Gratis snus tracker för iOS och Android."
  path="/sv"
  alternates={routes.home}
  imageAlt="Breezer: social snusapp – tracka, ranka och sluta"
  schema={[website, organization, mobileApp, faqPage(homeFaq[lang])]}
>
  <Header lang={lang} full />
  <Home t={t} lang={lang} />
  <Footer lang={lang} />
</Base>
