---
/**
 * The wide store assets of one page, dev server only:
 * - `header`: the iOS 27 product page header, 21:9 (3840 x 1646);
 * - `search`: the iOS 27 search results asset, 3:2 (3840 x 2560), which stands in
 *   for the screenshots in search, where most installs start;
 * - `feature`: Google Play's feature graphic (1024 x 500).
 * Photographed by scripts/capture-store.mjs next to the screenshots.
 *
 * The brand first (Klaus, 11.11.2026: "wie davor, mit dem Logo, wir haben einen
 * Brand"): the composition of Breezer's old feature graphic, done properly.
 * - Breezer's logo (the pouch and the wordmark, src/assets/images/logo) over
 *   the page's line, on the left, where the blue is deepest, so the white type
 *   and the logo's light pouch both stand out;
 * - the app on the right, tilted, where the blue turns light: the PRESS screen
 *   with the hand on the button, or the quit counter on the quit page. The
 *   default page fans the quit screen out behind the PRESS screen: both paths;
 * - the press, drawn: rings spreading from the button across the whole image,
 *   the one thing Breezer does.
 * No rating, "#1" or user count: Google Play does not allow ranking or
 * performance claims in store graphics, and Apple's assets must not date.
 * Apple's header is cropped differently on every device, so the logo and the
 * phone stay inside its middle.
 */
import '@fontsource/poppins/latin-ext-400.css';
import '@fontsource/poppins/latin-ext-600.css';
import '@fontsource/poppins/latin-ext-700.css';
import '@fontsource/poppins/latin-ext-800.css';
import '../../../../../../styles/style.css';
import { Image } from 'astro:assets';
import FramePhone from '../../../../../../components/store/FramePhone.astro';
import pressHand from '../../../../../../assets/images/app/press-hand.png';
import logoWhite from '../../../../../../assets/images/logo/logo-white.svg?raw';
import { LANGS, PAGES, PROMOS, copyFor, fromUrlLang, urlLang, type Lang, type PageId } from '../../../../../../data/storeShots';

/* The logo file keeps a margin around its artwork (pouch from x 47, wordmark to
   x 989, 27 to 173 high, measured); cropped to the artwork so the pouch lines
   up with the headline below it. */
const logo = logoWhite.replace('viewBox="0 0 1000 200" width="1000" height="200"', 'viewBox="46 26 945 148"');
if (logo === logoWhite) throw new Error('logo-white.svg changed: re-measure its artwork and update the crop');

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return (Object.keys(PAGES) as PageId[]).flatMap((page) =>
    LANGS.flatMap((lang) => PROMOS.map((p) => ({ params: { page, lang: urlLang(lang), kind: p.kind } }))),
  );
}

const params = Astro.params as { page: PageId; lang: string; kind: (typeof PROMOS)[number]['kind'] };
const { page, kind } = params;
const lang = fromUrlLang(params.lang) as Lang;
const promo = PROMOS.find((p) => p.kind === kind)!;
const W = promo.width;
const H = promo.height;
const line = copyFor(lang).promo[page];
const parts = line.split(/(\*[^*]+\*)/).filter(Boolean);

/* Play shows the feature graphic to Android users: an Android phone there. */
const os = kind === 'feature' ? 'android' : 'ios';
const front = page === 'quit' ? 'quit' : 'press';
const fan = page === 'default';
/* The iPhone shows only the middle of a 21:9 header, under the status bar
   (seen on a device, App Store iOS 27): the header is the logo and the line on
   the centre, with the press spreading behind them. The header video
   (motion/[kind].astro) is the one with the app in it. */
const centred = kind === 'header';

/*
 * Per format, in CSS px: the words (left edge, width, logo height, headline
 * size) and the phone (screen width, centre as shares of the canvas, tilt).
 * The words sit on the vertical middle; the phone is set low so it runs off
 * the bottom edge.
 */
const L = {
  feature: { x: 60, width: 450, logo: 44, title: 44, screen: 228, cx: 0.745, cy: 0.62, tilt: -9 },
  header: { x: 0, width: 900, logo: 104, title: 64, screen: 0, cx: 0.5, cy: 0.5, tilt: 0 },
  search: { x: 140, width: 990, logo: 88, title: 88, screen: 500, cx: 0.75, cy: 0.62, tilt: -9 },
}[kind];
const cx = W * L.cx;
const cy = H * L.cy;
const handW = L.screen * 0.5;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>promo {page} {lang} {kind}</title>
  </head>
  <body>
    <main class:list={['canvas', centred && 'canvas--centred']} style={`width:${W}px;height:${H}px;--x:${cx.toFixed(0)}px;--y:${cy.toFixed(0)}px`}>
      <div class="light" aria-hidden="true"></div>
      <div class="pulse" data-pulse aria-hidden="true">
        {Array.from({ length: 7 }, (_, i) => <span style={`--i:${i}`} />)}
      </div>

      {
        fan && !centred && (
          <div class="rig rig--back" style={`--tilt:${L.tilt + 15}deg`}>
            <FramePhone frame="quit" page={page} lang={lang} os={os} screenWidth={L.screen * 0.92} />
          </div>
        )
      }

      {
        !centred && (
          <div class="rig" data-rig style={`--tilt:${L.tilt}deg`}>
            <FramePhone frame={front} page={page} lang={lang} os={os} screenWidth={L.screen} />
            {front === 'press' && (
              <div class="hand" data-hand style={`width:${handW.toFixed(1)}px`}>
                <Image src={pressHand} width={640} height={1130} alt="" loading="eager" />
              </div>
            )}
          </div>
        )
      }

      <div
        class:list={['copy', centred && 'copy--centred']}
        style={`--t:${L.title}px;--logo:${L.logo}px;left:${centred ? W / 2 : L.x}px;width:${L.width}px`}
      >
        <div class="logo" set:html={logo} />
        <h1>
          {parts.map((p) => (p.startsWith('*') ? <span class="accent">{p.slice(1, -1)}</span> : p))}
        </h1>
      </div>
    </main>

    <script>
      // The hand's fingertip goes on the PRESS button and the rings spread from
      // it, wherever layout put the button. Measured with the phone upright,
      // because the hand lives inside the tilted rig; the rings are measured
      // after the tilt, because they live on the canvas. The fingertip is
      // 16.33% in from the hand image's left edge (AppHandCursor.astro).
      document.fonts.ready.then(() => {
        const canvas = document.querySelector<HTMLElement>('.canvas')!;
        const rig = document.querySelector<HTMLElement>('[data-rig]');
        const pulse = document.querySelector<HTMLElement>('[data-pulse]')!;
        const hand = document.querySelector<HTMLElement>('[data-hand]');
        /* No phone (the header): the rings spread from the logo. */
        const target =
          rig?.querySelector<HTMLElement>('[data-press-button]') ??
          rig?.querySelector<HTMLElement>('[data-quit-total-days]')?.parentElement ??
          rig ??
          document.querySelector<HTMLElement>('.logo')!;

        if (hand && rig) {
          rig.style.rotate = '0deg';
          const r = rig.getBoundingClientRect();
          const b = target.getBoundingClientRect();
          const w = hand.getBoundingClientRect().width;
          hand.style.left = `${b.left - r.left + b.width / 2 - w * 0.1633}px`;
          hand.style.top = `${b.top - r.top + b.height * 0.52}px`;
          rig.style.rotate = '';
        }

        const c = canvas.getBoundingClientRect();
        const b = target.getBoundingClientRect();
        pulse.style.left = `${b.left - c.left + b.width / 2}px`;
        pulse.style.top = `${b.top - c.top + b.height / 2}px`;
        pulse.style.setProperty('--r', `${b.width * (rig ? 0.62 : 0.32)}px`);
        canvas.dataset.placed = '';
      });
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #0b4fbf;
      }

      /* Neither the dev toolbar nor a stale Vite error overlay belongs in a frame. */
      astro-dev-toolbar,
      vite-error-overlay {
        display: none !important;
      }

      /* Deep blue under the words, Breezer's bright blue under the phone: the
         brand gradient laid left to right so each half gets the contrast it
         needs. */
      .canvas {
        position: relative;
        overflow: hidden;
        font-family: 'Poppins', sans-serif;
        -webkit-font-smoothing: antialiased;
        background: linear-gradient(100deg, #0a47b4 0%, #0d6bcd 38%, #1b95ee 68%, #3fc3fb 100%);
      }

      /* Centred, the blue deepens from the middle out, like a light on the logo. */
      .canvas--centred {
        background: radial-gradient(90% 150% at 50% 42%, #2aa6f3 0%, #1683e6 40%, #0d62c6 72%, #0a47b4 100%);
      }

      .canvas--centred .light {
        top: 42%;
        left: 50%;
        width: 80%;
        background: radial-gradient(closest-side, rgb(160 235 255 / 0.28), transparent 70%);
      }

      .canvas--centred .pulse span {
        border-width: 2px;
      }

      /* The light behind the phone. */
      .light {
        position: absolute;
        left: var(--x);
        top: calc(var(--y) * 0.75);
        width: 130%;
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        background: radial-gradient(closest-side, rgb(160 235 255 / 0.55), rgb(80 200 255 / 0.18) 45%, transparent 75%);
        pointer-events: none;
      }

      /* The press: rings from the button outward, each wider, thinner and
         fainter, the last ones reaching under the words. */
      .pulse {
        position: absolute;
        width: 0;
        height: 0;
        z-index: 1;
      }

      .pulse span {
        position: absolute;
        left: 0;
        top: 0;
        width: calc(var(--r, 60px) * 2 * (1 + var(--i) * var(--i) * 0.42 + var(--i) * 0.5));
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        border: calc(var(--r, 60px) * 0.035) solid rgb(255 255 255 / calc(0.34 - var(--i) * 0.045));
      }

      .rig {
        position: absolute;
        z-index: 4;
        left: var(--x);
        top: var(--y);
        translate: -50% -50%;
        rotate: var(--tilt);
        filter: drop-shadow(0 40px 50px rgb(2 22 70 / 0.5));
      }

      .rig--back {
        z-index: 3;
        margin-left: 16%;
        top: calc(var(--y) - 6%);
        filter: drop-shadow(0 30px 40px rgb(2 22 70 / 0.4)) brightness(0.92);
      }

      .hand {
        position: absolute;
        z-index: 5;
        filter: drop-shadow(0 18px 24px rgb(2 22 70 / 0.45));
      }

      .hand img {
        display: block;
        width: 100%;
        height: auto;
      }

      .copy {
        position: absolute;
        top: 50%;
        translate: 0 -50%;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(var(--t) * 0.55);
      }

      .copy--centred {
        translate: -50% -50%;
        align-items: center;
        text-align: center;
      }

      .logo {
        height: var(--logo);
        filter: drop-shadow(0 calc(var(--logo) * 0.12) calc(var(--logo) * 0.3) rgb(2 22 70 / 0.35));
      }

      .logo svg {
        display: block;
        width: auto;
        height: 100%;
      }

      h1 {
        margin: 0;
        font-size: var(--t);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.025em;
        text-wrap: balance;
        color: #fff;
        text-shadow: 0 2px calc(var(--t) * 0.4) rgb(2 22 70 / 0.35);
      }

      .accent {
        display: block;
      }
    </style>
  </body>
</html>
