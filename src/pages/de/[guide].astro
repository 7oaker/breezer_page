---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { mobileApp } from '../../i18n/schema';
import { guideSets, setFor } from '../../i18n/translations';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.lang === 'de' && !g.data.draft);
  return guides.map((entry) => ({ params: { guide: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * The tracker pages are the app's own money terms ("snus tracker", "zyn
 * tracker"), so the MobileApplication entity belongs on them rather than only
 * on the two homepages. The comparison and quit pages are editorial, and
 * claiming the app entity there would dilute what the node means.
 */
const APP_PAGES = ['snus-tracker', 'zyn-tracker'];
const extraSchema = APP_PAGES.includes(d.slug) ? [mobileApp as unknown as Record<string, unknown>] : [];

const alternates = setFor(await guideSets(), d.translationKey);
---

<Article
  lang="de"
  title={d.title}
  heading={d.heading}
  description={d.description}
  summary={d.summary}
  path={`/de/${d.slug}`}
  alternates={alternates}
  {/*
    Der Blog-Hub steht bewusst als Zwischenstufe drin, obwohl die URL
    /de/<slug> lautet und nicht /de/blog/<slug>. Brotkrumen bilden die
    Seitenhierarchie ab, nicht den Verzeichnispfad, und /de/blog listet
    diese Guides unter "Guides & Vergleiche". Ohne die Stufe las Google
    die Guides als direkt an der Startseite hängend, also als zu nichts
    gehörig. Die URLs bleiben, wo sie sind: sie ranken bereits.
  */}
  crumbs={[
    { name: 'Snus App', path: '/de' },
    { name: 'Blog', path: '/de/blog' },
    { name: d.heading, path: `/de/${d.slug}` },
  ]}
  extraSchema={extraSchema}
  publishDate={d.publishDate}
  updatedDate={d.updatedDate}
  faq={d.faq}
  heroImage={d.heroImage}
  heroImageAlt={d.heroImageAlt}
  gallery={d.gallery}
>
  <Content />
</Article>
