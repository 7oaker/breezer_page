---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'en' as const;
---

<Base
  lang={lang}
  title="Imprint | Breezer"
  description="Legal notice under § 5 ECG and § 25 MedienG (Austria) for breezer.now and the Breezer app."
  path="/imprint"
  noindex
>
  <Header lang={lang} />
  <main class="pt-[120px] pb-16">
    <article class="container max-w-[820px]">


            <h1 class="mb-2 text-3xl font-bold text-black dark:text-white sm:text-[44px]">Imprint</h1>
            <p class="mb-10 text-base text-body">
              Legal notice under § 5 ECG and § 25 MedienG (Austria) for breezer.now and the Breezer app.
              The binding version is the <a href="/de/impressum" class="text-primary hover:underline">German Impressum</a>.
            </p>

            <div class="space-y-6 text-base leading-relaxed text-body">
              <p>
                <span class="block font-semibold text-black dark:text-white">Media owner and service provider</span>
                Klaus Siebeneicher<br />
                Am Sonnenhang 2<br />
                3243 St. Leonhard am Forst<br />
                Austria
              </p>

              <p>
                <span class="block font-semibold text-black dark:text-white">Contact</span>
                <a href="mailto:info@breezer.now" class="text-primary hover:underline">info@breezer.now</a>
              </p>

              <p>
                <span class="block font-semibold text-black dark:text-white">Business purpose</span>
                Development and operation of the “Breezer” app and the website breezer.now.
              </p>

              <p>
                <span class="block font-semibold text-black dark:text-white">Legal form</span>
                Sole proprietorship, not registered in the Austrian commercial register. No VAT ID
                (small business exemption under § 6 (1) no. 27 UStG).
              </p>

              <p>
                <span class="block font-semibold text-black dark:text-white">Editorial policy</span>
                Information about the Breezer app and about tracking and reducing the use of nicotine pouches.
              </p>

              <p class="pt-4 text-sm">
                <a href="/de/impressum" class="text-primary hover:underline">Deutsche Fassung</a>
              </p>
            </div>
          </article>
  </main>
  <Footer lang={lang} />
</Base>
