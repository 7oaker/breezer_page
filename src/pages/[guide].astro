---
import { getCollection, render } from 'astro:content';
import Article from '../layouts/Article.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.lang === 'en' && !g.data.draft);
  return guides.map((entry) => ({ params: { guide: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Article
  lang="en"
  title={d.title}
  heading={d.heading}
  description={d.description}
  summary={d.summary}
  path={`/${d.slug}`}
  altPath={`/de/${d.translationOf}`}
  {/* See src/pages/de/[guide].astro for why the blog hub is a crumb here
      even though the URL is /<slug> and not /blog/<slug>. */}
  crumbs={[
    { name: 'Snus App', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: d.heading, path: `/${d.slug}` },
  ]}
  publishDate={d.publishDate}
  updatedDate={d.updatedDate}
  faq={d.faq}
  heroImage={d.heroImage}
  heroImageAlt={d.heroImageAlt}
  gallery={d.gallery}
>
  <Content />
</Article>
