---
import { getCollection, render } from 'astro:content';
import Article from '../layouts/Article.astro';
import { mobileApp } from '../i18n/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.lang === 'en' && !g.data.draft);
  return guides.map((entry) => ({ params: { guide: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * The tracker pages are the app's own money terms ("snus tracker", "zyn
 * tracker"), so the MobileApplication entity belongs on them rather than only
 * on the two homepages. The comparison and quit pages are editorial, and
 * claiming the app entity there would dilute what the node means.
 */
const APP_PAGES = ['snus-tracker', 'zyn-tracker'];
const extraSchema = APP_PAGES.includes(d.slug) ? [mobileApp as unknown as Record<string, unknown>] : [];
---

<Article
  lang="en"
  title={d.title}
  heading={d.heading}
  description={d.description}
  summary={d.summary}
  path={`/${d.slug}`}
  altPath={`/de/${d.translationOf}`}
  {/* See src/pages/de/[guide].astro for why the blog hub is a crumb here
      even though the URL is /<slug> and not /blog/<slug>. */}
  crumbs={[
    { name: 'Snus App', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: d.heading, path: `/${d.slug}` },
  ]}
  extraSchema={extraSchema}
  publishDate={d.publishDate}
  updatedDate={d.updatedDate}
  faq={d.faq}
  heroImage={d.heroImage}
  heroImageAlt={d.heroImageAlt}
  gallery={d.gallery}
>
  <Content />
</Article>
